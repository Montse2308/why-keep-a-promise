---
/**
 * The home is the film (ADR 0021): nine chapters that end in chapter 8's credits, which lead to the
 * notebook (ADR 0024).
 */
import Film from '../components/film/Film.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const title = t(locale, 'site.title');
---

<BaseLayout locale={locale} route="home" title={title} film>
  <Film locale={locale} />
</BaseLayout>
