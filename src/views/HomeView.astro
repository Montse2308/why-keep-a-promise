---
/**
 * The home is the film (ADR 0021): it tells every act of the previous version, and ends in chapter
 * 8's credits.
 */
import Film from '../components/film/Film.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const title = t(locale, 'site.title');
---

<BaseLayout locale={locale} route="home" title={title} film>
  <Film locale={locale} />
</BaseLayout>
