---
import type { Act } from '../lib/acts';
import { useTranslations, type Locale } from '../lib/i18n';
import { href } from '../lib/routes';

interface Props {
  act: Act;
  locale: Locale;
  /** Heading from the act's Markdown frontmatter; falls back to the act's UI key. */
  title?: string | undefined;
  /** No prose yet: show the act's TODO marker. */
  pending?: boolean;
}

const { act, locale, title, pending = false } = Astro.props;
const tr = useTranslations(locale);
const titleId = `${act.id}-title`;
const heading = title ?? tr(act.titleKey);
---

<section id={act.id} class="act container column" aria-labelledby={titleId}>
  <h2 id={titleId}>{heading}</h2>
  <slot />
  {pending && <p class="todo">TODO({act.contentPhase}): act content</p>}
  {act.deeper && (
    <p class="act__deeper">
      <a href={href(locale, act.deeper)}>{tr('deeper.link')}</a>
    </p>
  )}
</section>

<style>
  .act {
    padding-block: var(--space-12);
  }

  .act__deeper {
    font-family: var(--font-ui);
    font-size: var(--step-n1);
    font-weight: 600;
  }

  .act__deeper a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }
</style>
