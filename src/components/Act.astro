---
import type { Act } from '../lib/acts';
import { useTranslations, type Locale } from '../lib/i18n';
import { href } from '../lib/routes';

interface Props {
  act: Act;
  locale: Locale;
  /** Heading from the act's Markdown frontmatter; falls back to the act's UI key. */
  title?: string | undefined;
  /**
   * The first act is the hero: its heading is the page's h1, and the whole act is on the stage
   * (ADR 0018, ADR 0019): the question, the `first` slot (the first screen's stamp and author), the
   * act's prose, and the `scene` slot (act 1's scene and its table, ADR 0020).
   */
  hero?: boolean;
  /** No prose yet: show the act's TODO marker. */
  pending?: boolean;
  /** A sentence closing the act, set apart from its prose (act 5's manuscript status). */
  status?: string | undefined;
  /** The act renders content behind act 5's lock (ADR 0015); `verify:dist` looks for this mark. */
  lockedContent?: boolean;
  /** Show the act's "Go deeper →" link. */
  deeper?: boolean;
}

const { act, locale, title, hero = false, pending = false, status, lockedContent = false, deeper = true } = Astro.props;
const tr = useTranslations(locale);
const titleId = `${act.id}-title`;
const heading = title ?? tr(hero ? 'site.title' : act.titleKey);
---

{
  hero ? (
    <section id={act.id} class="act act--hero stage stage--flat" aria-labelledby={titleId}>
      <div class="container column act__head">
        <h1 id={titleId} class="display">
          {heading}
        </h1>
        <slot name="first" />
        <slot />
        {pending && <p class="todo">TODO({act.contentPhase}): act content</p>}
      </div>
      <slot name="scene" />
    </section>
  ) : (
    <section id={act.id} class="act container column" aria-labelledby={titleId} data-locked-content={lockedContent ? '' : undefined}>
      <h2 id={titleId}>{heading}</h2>
      <slot />
      {pending && <p class="todo">TODO({act.contentPhase}): act content</p>}
      {status && <p class="act__status">{status}</p>}
      {deeper && act.deeper && (
        <p class="act__deeper">
          <a href={href(locale, act.deeper)}>{tr('deeper.link')}</a>
        </p>
      )}
    </section>
  )
}

<style>
  .act {
    padding-block: var(--space-12);
  }

  .act :global(h1) {
    margin-block: var(--space-8) var(--space-6);
  }

  /* Act 1: the stage from the top of the page; the scene brings its own space. */
  .act--hero {
    padding-block: 0;
  }

  .act__head {
    padding-top: var(--space-4);
  }

  .act__status {
    font-style: italic;
    color: var(--color-muted);
  }

  .act__deeper {
    font-family: var(--font-ui);
    font-size: var(--step-n1);
    font-weight: 600;
  }

  .act__deeper a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }
</style>
