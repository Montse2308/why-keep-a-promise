---
import type { Act } from '../lib/acts';
import { useTranslations, type Locale } from '../lib/i18n';
import { href } from '../lib/routes';

interface Props {
  act: Act;
  locale: Locale;
  /** Heading from the act's Markdown frontmatter; falls back to the act's UI key. */
  title?: string | undefined;
  /** The first act is the hero: its heading is the page's h1. */
  hero?: boolean;
  /** No prose yet: show the act's TODO marker. */
  pending?: boolean;
}

const { act, locale, title, hero = false, pending = false } = Astro.props;
const tr = useTranslations(locale);
const titleId = `${act.id}-title`;
const heading = title ?? tr(hero ? 'site.title' : act.titleKey);
---

<section id={act.id} class="act container column" aria-labelledby={titleId}>
  {hero ? <h1 id={titleId}>{heading}</h1> : <h2 id={titleId}>{heading}</h2>}
  <slot />
  {pending && <p class="todo">TODO({act.contentPhase}): act content</p>}
  {
    act.deeper && (
      <p class="act__deeper">
        <a href={href(locale, act.deeper)}>{tr('deeper.link')}</a>
      </p>
    )
  }
</section>

<style>
  .act {
    padding-block: var(--space-12);
  }

  .act + .act {
    border-top: var(--border-width) solid var(--color-border);
  }

  .act :global(h1) {
    margin-block: var(--space-8) var(--space-6);
  }

  .act__deeper {
    font-family: var(--font-ui);
    font-size: var(--step-n1);
    font-weight: 600;
  }

  .act__deeper a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }

  /* Static tables in the prose (act 2's matrix, act 3's predictions): hairlines, sans, tabular. */
  .act > :global(table) {
    width: 100%;
    margin-block: var(--space-6);
    border-collapse: collapse;
    font-family: var(--font-ui);
    font-size: var(--step-n1);
    line-height: var(--leading-ui);
    font-variant-numeric: tabular-nums;
  }

  .act > :global(table) :global(th),
  .act > :global(table) :global(td) {
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
    text-align: start;
    vertical-align: top;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .act > :global(table) :global(thead th) {
    color: var(--color-muted);
    font-weight: 600;
  }

  .act > :global(ol) {
    padding-inline-start: 1.5em;
  }

  .act > :global(ol li + li) {
    margin-top: var(--space-2);
  }
</style>
