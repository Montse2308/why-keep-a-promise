---
import type { Act } from '../lib/acts';
import { useTranslations, type Locale } from '../lib/i18n';
import { href } from '../lib/routes';

interface Props {
  act: Act;
  locale: Locale;
  /** The first act is the hero: its heading is the page's h1. */
  heading?: string;
}

const { act, locale, heading } = Astro.props;
const tr = useTranslations(locale);
const titleId = `${act.id}-title`;
---

<section id={act.id} class="act container" aria-labelledby={titleId}>
  {heading ? <h1 id={titleId}>{heading}</h1> : <h2 id={titleId}>{tr(act.titleKey)}</h2>}
  <slot />
  <p class="todo">TODO({act.contentPhase}): act content</p>
  {act.deeper && (
    <p class="act__deeper">
      <a href={href(locale, act.deeper)}>{tr('deeper.link')}</a>
    </p>
  )}
</section>

<style>
  .act {
    padding-block: var(--space-12);
  }

  .act :global(h1) {
    font-size: var(--text-2xl);
    max-width: 20ch;
  }
</style>
