---
import LanguageSwitch from './LanguageSwitch.astro';
import { AUTHOR } from '../config';
import { useTranslations, type Locale } from '../lib/i18n';
import type { Route } from '../lib/routes';

interface Props {
  locale: Locale;
  route: Route;
}

const { locale, route } = Astro.props;
const tr = useTranslations(locale);
---

<header class="strip">
  <div class="strip__inner container">
    <span class="strip__name">{tr('author.name')}</span>
    <nav class="strip__author" aria-label={tr('strip.label')}>
      <a href={AUTHOR.github} rel="me noopener">{tr('author.github')}</a>
      {AUTHOR.linkedin && <a href={AUTHOR.linkedin} rel="me noopener">{tr('author.linkedin')}</a>}
    </nav>
    <LanguageSwitch locale={locale} route={route} />
  </div>
</header>

<style>
  .strip {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    height: var(--strip-height);
    background: var(--color-bg);
    border-bottom: var(--border-width) solid var(--color-border);
    font-family: var(--font-ui);
    font-size: var(--step-n1);
    line-height: var(--leading-ui);
  }

  /* Narrow screens: the name on its own row, links and language below it (--strip-height grows). */
  .strip__inner {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-4);
    height: 100%;
  }

  .strip__name {
    flex-basis: 100%;
    padding-top: var(--space-2);
    overflow: hidden;
    font-weight: 600;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .strip__author {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .strip a {
    display: inline-flex;
    flex: none;
    align-items: center;
    min-height: var(--target-min);
  }

  /* Wide screens: one row. */
  @media (min-width: 40rem) {
    .strip__inner {
      flex-wrap: nowrap;
    }

    .strip__name {
      flex-basis: auto;
      padding-top: 0;
    }

    .strip__author {
      margin-inline-end: auto;
    }
  }
</style>
