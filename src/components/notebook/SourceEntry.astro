---
/**
 * One entry of /sources (ADR 0024): what a source key's figures are, the figures the register gives
 * it, where they are in the source and where they are used. The finding's entries carry
 * `data-locked-content` (ADR 0035); only SourcesFinding.astro, behind the lock, passes `locked`.
 */
import { getCollection } from 'astro:content';
import { chapter } from '../../lib/chapters';
import { hasKey, useTranslations, type Locale } from '../../lib/i18n';
import { notebookPage } from '../../lib/notebook';
import { href } from '../../lib/routes';
import { atKey, figuresOf, UNVERIFIED, whatKey, type Entry, type Place } from '../../lib/sources';
import { fill } from '../../lib/template';

interface Props {
  locale: Locale;
  entry: Entry;
  locked?: boolean;
}

const { locale, entry, locked = false } = Astro.props;
const tr = useTranslations(locale);
const chapters = await getCollection('chapters', (candidate) => candidate.id.startsWith(`${locale}/`));

function place(where: Place): { label: string; url: string } {
  if ('page' in where) return { label: tr(notebookPage(where.page).titleKey), url: href(locale, where.page) };
  const found = chapters.find((candidate) => candidate.data.chapter === where.chapter);
  if (!found) throw new Error(`No chapter "${where.chapter}" in ${locale}`);
  return { label: `${fill(tr('film.chapter'), { n: chapter(where.chapter).number })} · ${found.data.title}`, url: href(locale, 'home', where.chapter) };
}

const figures = figuresOf(entry.source);
const at = atKey(entry);
const located = hasKey(at) ? at : null;
const places = entry.places.map(place);
---

<li class="sources__entry" data-locked-content={locked ? '' : undefined}>
  <p class="sources__what">{tr(whatKey(entry))}</p>
  {
    figures.length > 0 && (
      <p class="sources__row">
        <span class="sources__term">{tr('sources.figures')}</span>
        <span class="sources__figures">
          {figures.map((figure) => (
            <span class="sources__figure">{figure}</span>
          ))}
        </span>
      </p>
    )
  }
  {
    located && (
      <p class="sources__row">
        <span class="sources__term">{tr('sources.at')}</span>
        <span class="sources__located">{tr(located)}</span>
      </p>
    )
  }
  {
    !located && UNVERIFIED.includes(entry.source) && (
      <p class="sources__row" data-unverified>
        <span class="sources__term">{tr('sources.at')}</span>
        <span class="sources__unverified">{tr('sources.unverified')}</span>
      </p>
    )
  }
  {
    places.length > 0 && (
      <p class="sources__row">
        <span class="sources__term">{tr('sources.used')}</span>
        <span class="sources__places">
          {places.map((found, i) => (
            <>
              {i > 0 && <span class="sources__dot" aria-hidden="true">·</span>}
              <a href={found.url}>{found.label}</a>
            </>
          ))}
        </span>
      </p>
    )
  }
</li>

<style>
  /* Each figure's entry is a slip of the notebook's paper. */
  .sources__entry {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-paper);
  }

  .sources__what {
    margin: 0;
    font-weight: 700;
  }

  .sources__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    margin: 0;
  }

  .sources__term {
    margin: 0;
    font-size: var(--step-n2);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .sources__figures,
  .sources__places {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
  }

  .sources__figure {
    padding: 0 var(--space-2);
    border: var(--border-width) solid var(--color-control);
    border-radius: 999px;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .sources__places a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-weight: 700;
  }

  .sources__unverified {
    font-style: italic;
    color: var(--color-muted);
  }

  .sources__dot {
    align-self: center;
    color: var(--color-muted);
  }
</style>
