---
/**
 * A small drawing at the head of each notebook page (ADR 0027: the notebook's illustrations are of
 * the film's family): the cast and the props of the film as paper cut-outs, each with its double
 * edge of ink and paper, so they hold on day paper and on night paper alike. Decorative: the page's
 * title says what it is. None of them draws a real person (ADR 0021), and none shows a population,
 * a dynamic or a chart (ADR 0023).
 */
import Character from '../film/Character.astro';
import { FILM } from '../../lib/design/film';
import { PIP_AT, PIPS, type Pip } from '../../lib/film/parts';
import type { Subpage } from '../../lib/routes';

interface Props {
  page: Subpage;
}

const { page } = Astro.props;
const shadow = `vignette-${page}`;
/** A paper edge: ink outside, the paper rim inside, then the fill. */
const edge = { stroke: FILM.ink, 'stroke-width': 9, 'stroke-linejoin': 'round' } as const;
const rim = { stroke: FILM.rim, 'stroke-width': 4.5, 'stroke-linejoin': 'round' } as const;
---

<svg class="vignette" viewBox="-170 -78 340 156" aria-hidden="true" focusable="false">
  <defs>
    <filter id={shadow} x="-40%" y="-40%" width="180%" height="190%">
      <feDropShadow dx="0" dy="6" stdDeviation="5" flood-color="#281e3c" flood-opacity="0.25" />
    </filter>
  </defs>

  {
    page === 'dilemma' && (
      <>
        <g filter={`url(#${shadow})`}>
          <rect x="-8" y="-58" width="16" height="122" rx="4" fill={FILM.rim} {...edge} />
          <rect x="-8" y="-58" width="16" height="122" rx="4" fill={FILM.rim} {...rim} />
        </g>
        <g transform="translate(-96 8) scale(0.7)">
          <Character kind="circle" mood="tempted" shadow={shadow} />
        </g>
        <g transform="translate(96 8) scale(0.7)">
          <Character kind="square" mood="tempted" shadow={shadow} />
        </g>
      </>
    )
  }

  {
    page === 'vanberg' && (
      <>
        <g transform="translate(-110 14) scale(0.52)">
          <Character kind="circle" mood="worried" shadow={shadow} />
        </g>
        <g transform="translate(0 -18) rotate(-10)" filter={`url(#${shadow})`}>
          <rect x="-23" y="-23" width="46" height="46" rx="10" fill={FILM.rim} {...edge} />
          <rect x="-23" y="-23" width="46" height="46" rx="10" fill={FILM.rim} {...rim} />
          {PIPS[5].map((pip: Pip) => <circle cx={PIP_AT[pip][0] * 0.62} cy={PIP_AT[pip][1] * 0.62} r="4.6" fill={FILM.ink} />)}
        </g>
        <path d="M-74 40 C -40 22, 40 22, 74 40" fill="none" stroke={FILM['thread-edge']} stroke-width="8" stroke-linecap="round" />
        <path d="M-74 40 C -40 22, 40 22, 74 40" fill="none" stroke={FILM.thread} stroke-width="4.5" stroke-linecap="round" />
        <g transform="translate(110 14) scale(0.52)">
          <Character kind="square" mood="happy" shadow={shadow} />
        </g>
      </>
    )
  }

  {
    page === 'finding' && (
      <g filter={`url(#${shadow})`}>
        <rect x="-78" y="-24" width="156" height="92" rx="8" fill={FILM.card} {...edge} />
        <rect x="-78" y="-24" width="156" height="92" rx="8" fill={FILM.card} {...rim} />
        <path d="M-74 -20 L0 -74 L74 -20" fill={FILM['voice-word']} stroke={FILM.ink} stroke-width="5" stroke-linejoin="round" />
        <path d="M-56 20 H56 M-56 40 H24" stroke={FILM['card-muted']} stroke-width="5" stroke-linecap="round" />
        <circle cx="0" cy="-20" r="15" fill={FILM.thread} stroke={FILM['thread-edge']} stroke-width="4" />
      </g>
    )
  }

  {
    page === 'how-its-built' && (
      <g filter={`url(#${shadow})`}>
        {[-108, 0, 108].map((cx, i) => (
          <g transform={`translate(${cx} 0) rotate(${[-4, 2, -2][i]})`}>
            <rect x="-48" y="-38" width="96" height="76" rx="7" fill={FILM.card} {...edge} />
            <rect x="-48" y="-38" width="96" height="76" rx="7" fill={[FILM.lamp, '#d3eaff', FILM['voice-expects']][i]} {...rim} />
            <circle cx="-20" cy="10" r="13" fill={FILM.you} stroke={FILM.ink} stroke-width="3.5" />
            <rect x="9" y="-3" width="24" height="24" rx="5" fill={FILM.other} stroke={FILM.ink} stroke-width="3.5" />
            {i > 0 && <path d="M-7 4 C -2 -6, 4 -6, 9 2" fill="none" stroke={FILM['thread-edge']} stroke-width="4" stroke-linecap="round" />}
          </g>
        ))}
      </g>
    )
  }

  {
    page === 'sources' && (
      <g filter={`url(#${shadow})`}>
        {[-1, 1].map((side) => (
          <g transform={`translate(${side * 44} ${side * -4}) rotate(${side * 5})`}>
            <rect x="-56" y="-62" width="112" height="124" rx="6" fill={FILM.card} {...edge} />
            <rect x="-56" y="-62" width="112" height="124" rx="6" fill={FILM.card} {...rim} />
            {[-34, -16, 2, 20, 38].map((y, j) => (
              <path d={`M-38 ${y} H${j % 2 === 0 ? 38 : 18}`} stroke={FILM['card-muted']} stroke-width="5" stroke-linecap="round" />
            ))}
          </g>
        ))}
        <path d="M70 -66 V -6 L82 -18 L94 -6 V -66" fill={FILM.thread} stroke={FILM['thread-edge']} stroke-width="4" stroke-linejoin="round" />
      </g>
    )
  }

  {
    page === 'about' && (
      <g transform="scale(2.6)" filter={`url(#${shadow})`}>
        <rect x="-15" y="-19" width="30" height="7" rx="3" fill={FILM['table-front']} stroke={FILM.ink} stroke-width="2.5" />
        <rect x="-15" y="12" width="30" height="7" rx="3" fill={FILM['table-front']} stroke={FILM.ink} stroke-width="2.5" />
        <rect x="-10" y="-12" width="20" height="24" fill={FILM.thread} stroke={FILM.ink} stroke-width="2.5" />
        <path d="M-10 -6 H10 M-10 0 H10 M-10 6 H10" stroke={FILM['thread-edge']} stroke-width="1.5" />
        <path d="M10 4 C 22 8, 30 -4, 44 2" fill="none" stroke={FILM['thread-edge']} stroke-width="3" stroke-linecap="round" />
        <path d="M10 4 C 22 8, 30 -4, 44 2" fill="none" stroke={FILM.thread} stroke-width="1.6" stroke-linecap="round" />
      </g>
    )
  }
</svg>

<style>
  .vignette {
    display: block;
    width: min(16rem, 70%);
    height: auto;
    overflow: visible;
  }
</style>
