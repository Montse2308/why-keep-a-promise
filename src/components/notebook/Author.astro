---
/**
 * /about (ADR 0024, ADR 0041, rule (j)): the author's full name, GitHub, LinkedIn, ORCID and her author
 * page on SSRN (`AUTHOR` in src/config.ts), each with rel="me", and nothing else: no school, job, city
 * or biography. The SSRN page lists the working paper, so it is linked only behind the lock (ADR 0034).
 */
import { AUTHOR, WORKING_PAPER } from '../../config';
import { externalAttrs, externalMark } from '../../lib/external';
import { useTranslations, type Locale, type UiKey } from '../../lib/i18n';
import { findingUnlocked } from '../../lib/lock';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = useTranslations(locale);
const unlocked = findingUnlocked(WORKING_PAPER.ssrn, import.meta.env.DEV);
const profiles: { url: string; key: UiKey }[] = [
  { url: AUTHOR.github, key: 'author.github' },
  { url: AUTHOR.linkedin, key: 'author.linkedin' },
  { url: AUTHOR.orcid, key: 'author.orcid' },
  ...(unlocked ? [{ url: AUTHOR.ssrn, key: 'author.ssrn' as const }] : []),
];
---

<div class="author">
  <p class="author__name">{tr('author.name')}</p>
  <ul class="author__links" role="list">
    {profiles.map((profile) => <li><a href={profile.url} {...externalAttrs(profile.url, 'me')}>{tr(profile.key)}<Fragment set:html={externalMark(profile.url, locale)} /></a></li>)}
  </ul>
</div>

<style>
  .author {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-6) var(--space-8);
  }

  .author__name {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--step-3);
    font-weight: 800;
    line-height: var(--leading-tight);
    text-wrap: balance;
  }

  .author__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .author__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    padding: 0 var(--space-6);
    border: var(--border-width) solid var(--color-control);
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: var(--shadow-paper);
    font-family: var(--font-ui);
    font-weight: 800;
    text-decoration: none;
  }

  .author__links a:hover {
    border-color: var(--color-fg);
  }
</style>
