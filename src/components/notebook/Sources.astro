---
/**
 * /sources (ADR 0024): the works the page draws on, each with its full reference and, under it, every
 * figure it gives and where that figure is used, from the register (src/lib/sources.ts). This part
 * looks the same in both states of the lock (ADR 0034): it lists none of the finding's sources, and it
 * links to no chapter or page the lock keeps closed. The finding's sources join it from
 * SourcesFinding.astro, which a locked build does not have (ADR 0035). Where a source's pages are
 * still to be verified, an entry says so, marked for the deploy to refuse (`UNVERIFIED`).
 */
import type { Locale } from '../../lib/i18n';
import { worksOf } from '../../lib/sources';
import SourcesFinding from './SourcesFinding.astro';
import SourceWork from './SourceWork.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const groups = worksOf();
---

<div class="sources">
  {
    groups.map(({ work, entries }) => (
      <SourceWork locale={locale} work={work} entries={entries}>
        <SourcesFinding locale={locale} work={work.id} />
      </SourceWork>
    ))
  }
  <SourcesFinding locale={locale} />
</div>

<style>
  .sources {
    display: grid;
    gap: var(--space-8);
    margin-block: var(--space-6);
  }
</style>
