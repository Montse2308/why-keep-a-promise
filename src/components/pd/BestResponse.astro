---
/**
 * The best-reply exercise on /dilemma (ADR 0017): the prisoner's dilemma matrix of act 2, where the
 * visitor picks a move against each column. It is not Vanberg's game (docs/content-rules.md, rule
 * (g)); it is a figure on paper, from the notebook's tokens. Logic in src/lib/pd/; ./controller.ts
 * drives it. Without JavaScript, the static matrix shows instead.
 */
import { useTranslations, type Locale } from '../../lib/i18n';
import { cellKey } from '../../lib/pd/bestReply';
import { MOVES, payoff } from '../../lib/pd/game';
import { pdStrings } from '../../lib/pd/strings';
import { fill } from '../../lib/template';

interface Props {
  locale: Locale;
  /** Unique on the page; prefixes every id inside the figure. */
  id: string;
}

const { locale, id } = Astro.props;
const tr = useTranslations(locale);
const cell = (you: (typeof MOVES)[number], other: (typeof MOVES)[number]) => fill(tr('pd.cell'), { ...payoff(you, other) });
---

<figure class="best-reply wide" id={id} data-best-reply data-strings={JSON.stringify(pdStrings(tr))} aria-labelledby={`${id}-caption`}>
  <figcaption id={`${id}-caption`} class="br-label">{tr('pd.caption')}</figcaption>

  <table class="br-grid">
    <caption class="br-note">{tr('pd.matrix.caption')}</caption>
    <thead>
      <tr>
        <td></td>
        {MOVES.map((other) => <th scope="col" data-column={other}>{tr(`pd.col.${other}`)}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        MOVES.map((you) => (
          <tr>
            <th scope="row">{tr(`pd.row.${you}`)}</th>
            {MOVES.map((other) => (
              <td class="br-cell" data-cell={cellKey(you, other)} data-column={other}>
                <span class="br-num">{cell(you, other)}</span>
                <span class="br-tags" data-tags></span>
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>

  <div class="br-live" data-live hidden>
    <section class="br-step" data-step="ask" aria-labelledby={`${id}-ask`}>
      <p class="br-label" id={`${id}-step`}>{tr('pd.step')}</p>
      <p class="br-summary" id={`${id}-ask`} data-slot="ask"></p>
      <div class="br-actions" data-controls role="group" aria-labelledby={`${id}-ask`}>
        {MOVES.map((move) => <button type="button" class="br-button" data-move={move}>{tr(`pd.move.${move}`)}</button>)}
      </div>
    </section>

    <ol class="br-log" data-slot="log" hidden></ol>

    <section class="br-step" data-step="done" hidden>
      <p class="br-summary" data-slot="dominant"></p>
      <p class="br-summary" data-slot="equilibrium"></p>
      <div class="br-actions">
        <button type="button" class="br-button" data-action="reset">{tr('pd.again')}</button>
      </div>
    </section>

    <p class="visually-hidden" role="status" aria-live="polite" data-slot="status"></p>
  </div>

  <noscript>
    <p class="br-note">{tr('pd.noscript')}</p>
  </noscript>
</figure>

<script>
  import { mountAll } from './controller';

  mountAll();
</script>

<style>
  /* A figure on paper: frame, labels and buttons from the notebook's tokens. */
  .best-reply {
    display: grid;
    gap: var(--space-6);
    margin: var(--space-8) auto;
    padding: var(--space-4);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-ui);
    font-size: var(--step-n1);
    line-height: var(--leading-ui);
  }

  @media (min-width: 40rem) {
    .best-reply {
      padding: var(--space-6);
    }
  }

  .br-label {
    margin: 0 0 var(--space-3);
    font-size: var(--step-n2);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-align: start;
  }

  .br-grid {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .br-grid caption {
    caption-side: top;
    text-align: start;
  }

  .br-grid th,
  .br-grid td {
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-2);
    text-align: start;
    vertical-align: top;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .br-grid th {
    font-weight: 600;
  }

  .br-grid thead th {
    color: var(--color-muted);
    vertical-align: bottom;
  }

  /* The column being asked about: a border and its heading in the text colour, not colour alone. */
  .br-grid [data-active] {
    background: var(--color-surface-hover);
  }

  .br-grid thead th[data-active] {
    color: var(--color-fg);
    box-shadow: inset 0 calc(-1 * var(--focus-width)) 0 var(--color-fg);
  }

  .br-num {
    display: block;
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--color-fg);
  }

  .br-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-1);
  }

  .br-tags:empty {
    display: none;
  }

  .br-tags :global(.br-tag) {
    display: inline-block;
    padding: 0 var(--space-2);
    font-size: var(--step-n2);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-fg);
    border: var(--border-width) solid var(--color-control);
    border-radius: var(--radius-sm);
  }

  /* The visitor's own pick carries the "you" role colour, as at the table. */
  .br-tags :global(.br-tag[data-tag='pick']) {
    color: var(--color-you);
    border-color: currentColor;
  }

  .br-cell[data-picked] {
    outline: var(--focus-width) solid var(--color-fg);
    outline-offset: -2px;
  }

  .br-live {
    display: grid;
    gap: var(--space-4);
  }

  .br-step > :last-child {
    margin-bottom: 0;
  }

  .br-summary {
    margin: 0 0 var(--space-3);
    font-weight: 600;
  }

  .br-note {
    margin: 0 0 var(--space-2);
    color: var(--color-muted);
  }

  .br-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .br-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--target-min);
    min-width: var(--target-min);
    padding: var(--space-2) var(--space-4);
    font: inherit;
    font-weight: 600;
    color: var(--color-fg);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-control);
    border-radius: var(--radius-sm);
    cursor: pointer;
    touch-action: manipulation;
  }

  .br-button:hover {
    background: var(--color-surface-hover);
  }

  .br-button:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: 2px;
  }

  .br-log {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-inline-start: 1.5em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .br-step[data-entered] {
      animation: br-enter var(--duration-base) var(--ease-standard);
    }
  }

  @keyframes br-enter {
    from {
      opacity: 0;
      transform: translateY(0.25rem);
    }
  }
</style>
