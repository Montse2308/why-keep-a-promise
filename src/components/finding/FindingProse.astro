---
/**
 * How /finding's own blocks of prose look (ADR 0037). Its Markdown wraps them in plain HTML: the line
 * under the title (`.lede`), the box «In one minute» (`.minute`), the two columns of what was known and
 * what this work adds (`.known`, a definition list), and the explorer's block (`[data-explorer-block]`,
 * hidden until its script runs, ADR 0038). This component draws nothing; it only brings their styles
 * to the one page that has them.
 *
 * Render this only inside the lock (ADR 0034): a locked build resolves it to ../curve/Locked.astro
 * (astro.config.mjs).
 */
---

<style is:global>
  /* The line under the title, as its subtitle. */
  .subpage .lede {
    margin: 0 0 var(--space-8);
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-style: italic;
    line-height: var(--leading-tight);
    color: var(--color-muted);
    text-wrap: pretty;
  }

  /* «In one minute»: a box of paper with a border, the four points and the three buttons. */
  .subpage .minute {
    margin-block: var(--space-6) var(--space-4);
    padding: var(--space-6) var(--space-4);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-control);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-paper);
  }

  @media (min-width: 40rem) {
    .subpage .minute {
      padding: var(--space-8);
    }
  }

  /* Above the notebook's rule for every h2 of the page. */
  .subpage .minute > h2:first-child {
    margin-top: 0;
  }

  .subpage .minute ul:not([role]) {
    margin: 0;
    padding-inline-start: 1.25em;
  }

  .subpage .minute ul:not([role]) li + li {
    margin-top: var(--space-3);
  }

  /* What was known and what this work adds: one column on a phone, two from about 768 px. */
  .subpage .known {
    display: grid;
    gap: var(--space-6);
    margin-block: var(--space-12) 0;
  }

  @media (min-width: 48rem) {
    .subpage .known {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  .subpage .known__column {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .subpage .known dt {
    padding-bottom: var(--space-2);
    border-bottom: var(--border-width) solid var(--color-border);
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-weight: 800;
    line-height: var(--leading-tight);
  }

  .subpage .known dd {
    margin: 0;
    padding-inline-start: var(--space-4);
    border-inline-start: 3px solid var(--color-border);
  }

  /* The explorer's block stays out of the page until its script shows it (ADR 0038). */
  .subpage [data-explorer-block][hidden] {
    display: none;
  }
</style>
