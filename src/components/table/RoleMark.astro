---
/** The shape of a role: a circle for you, a square for the other. Colour never goes alone (ADR 0014). */
interface Props {
  role: 'you' | 'other';
}

const { role } = Astro.props;
---

<svg class={`mark mark--${role}`} viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false">
  {role === 'you' ? <circle cx="6" cy="6" r="5.25" /> : <rect x="1" y="1" width="10" height="10" rx="1" />}
</svg>

<style>
  .mark {
    flex: none;
    width: 0.75em;
    height: 0.75em;
    vertical-align: -0.05em;
  }

  .mark--you {
    fill: var(--color-you);
  }

  .mark--other {
    fill: var(--color-other);
  }
</style>
