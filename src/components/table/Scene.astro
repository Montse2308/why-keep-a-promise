---
/**
 * Act 1's scene (ADR 0020): the table before moment 1, drawn in SVG and moved by the scroll alone,
 * with CSS. There is no script here: the table's own controller only clears the still version once
 * the visitor chooses. The progress stops, the captions and the payoffs come from
 * src/lib/table/scene.ts; tests check this file against it (tests/scene.test.ts).
 *
 * Three rules shape it:
 *  - The still version is the default: the drawing at beat 5 with the captions as a numbered list.
 *    The scroll-bound version is added only where the browser supports scroll timelines, motion is
 *    allowed and scripting is on, so reduced motion, older browsers and no JavaScript all get the
 *    still version.
 *  - The scroll is never hijacked: the frame is `position: sticky` inside a tall track, and each beat
 *    advances or rewinds with the native scroll position. Nothing snaps, nothing listens to the wheel.
 *  - Moment 1's controls come after the track, so they are on screen only once the scene reached
 *    beat 6; focusing them from the keyboard scrolls the scene to its end.
 */
import { useTranslations, type Locale } from '../../lib/i18n';
import { SCENE_FACE, sceneCaptions, scenePayoffs } from '../../lib/table/scene';
import { fill } from '../../lib/template';

interface Props {
  locale: Locale;
  /** The id of the table this scene belongs to; its controller clears the still version. */
  table: string;
}

const { locale, table } = Astro.props;
const tr = useTranslations(locale);
const payoffs = scenePayoffs();
const captions = sceneCaptions(tr);
const message = tr('scene.message');
const alt = fill(tr('scene.alt'), { message });

// Pip positions on a die face 24 units wide, centred on its origin.
const PIP = { tl: [-6, -6], tr: [6, -6], c: [0, 0], bl: [-6, 6], br: [6, 6] } as const;
type Pip = keyof typeof PIP;
const BEFORE: readonly Pip[] = ['tl', 'c', 'br']; // resting, before the roll: any face but the landing one
const AFTER: Record<number, readonly Pip[]> = { 5: ['tl', 'tr', 'c', 'bl', 'br'] };
const landed = AFTER[SCENE_FACE];
if (!landed) throw new Error(`No pips drawn for face ${SCENE_FACE}`);
---

<div class="scene" data-scene={table}>
  <div class="scene__track">
    <div class="scene__frame">
      <svg class="scene__svg" viewBox="0 0 360 216" role="img" aria-label={alt}>
        <!-- The table, with the die between the two seats. -->
        <rect class="sc-table" x="76" y="118" width="208" height="40" rx="12" />
        <g transform="translate(180 112)">
          <g class="sc-die">
            <rect class="sc-die__face" x="-12" y="-12" width="24" height="24" rx="5" />
            <g class="sc-pips sc-pips--before">{BEFORE.map((pip) => <circle cx={PIP[pip][0]} cy={PIP[pip][1]} r="2.4" />)}</g>
            <g class="sc-pips sc-pips--after">{landed.map((pip) => <circle cx={PIP[pip][0]} cy={PIP[pip][1]} r="2.4" />)}</g>
          </g>
        </g>

        <!-- A: writes, is tagged "decides", rolls. -->
        <g transform="translate(48 112)">
          <g class="sc-person sc-a">
            <path class="sc-body" d="M-22 30 Q-22 4 0 4 Q22 4 22 30 Z" />
            <circle class="sc-head" cx="0" cy="-12" r="13" />
            <text class="sc-letter" x="0" y="-8" text-anchor="middle">A</text>
            <g transform="translate(0 48)">
              <g class="sc-tag">
                <rect x="-27" y="-10" width="54" height="20" rx="10" />
                <text x="0" y="4" text-anchor="middle">{tr('scene.tag.decides')}</text>
              </g>
            </g>
          </g>
        </g>

        <!-- B: receives A's promise, then leaves with it. In the still version B waits apart, faded. -->
        <g transform="translate(312 112)">
          <g class="sc-person sc-b">
            <path class="sc-body" d="M-22 30 Q-22 4 0 4 Q22 4 22 30 Z" />
            <circle class="sc-head" cx="0" cy="-12" r="13" />
            <text class="sc-letter" x="0" y="-8" text-anchor="middle">B</text>
            <g transform="translate(-34 -2)">
              <path class="sc-diamond sc-diamond--a" d="M0 -7 L7 0 L0 7 L-7 0 Z" />
            </g>
            <text class="sc-away" x="22" y="46" text-anchor="end">{tr('scene.before-switch')}</text>
          </g>
        </g>

        <!-- C: arrives in B's seat, with a promise from another decider. -->
        <g transform="translate(312 112)">
          <g class="sc-person sc-c">
            <path class="sc-body" d="M-22 30 Q-22 4 0 4 Q22 4 22 30 Z" />
            <circle class="sc-head" cx="0" cy="-12" r="13" />
            <text class="sc-letter" x="0" y="-8" text-anchor="middle">C</text>
            <g transform="translate(-34 -2)">
              <path class="sc-diamond" d="M0 -7 L7 0 L0 7 L-7 0 Z" />
            </g>
          </g>
        </g>

        <!-- A's message: illustrative, not a participant's words (rule (k)). -->
        <g class="sc-bubble">
          <rect x="88" y="30" width="184" height="34" rx="10" />
          <path d="M100 63 L70 86 L124 63 Z" />
          <text class="sc-bubble__text" x="180" y="52" text-anchor="middle">{message}</text>
        </g>

        <!-- The table's payoffs, not the face's: 10 instead of 14, and 10 expected (rule (k)). -->
        <g class="sc-chips">
          <g transform="translate(4 176)">
            <rect x="0" y="0" width="116" height="30" rx="8" />
            <text class="sc-chip__n" x="12" y="21">{payoffs.roll}</text>
            <text class="sc-chip__note" x="38" y="19">{fill(tr('scene.chip.instead'), { dont: payoffs.dont })}</text>
          </g>
          <g transform="translate(240 176)">
            <rect x="0" y="0" width="116" height="30" rx="8" />
            <text class="sc-chip__n" x="12" y="21">{payoffs.expected}</text>
            <text class="sc-chip__note" x="38" y="19">{tr('table.expected').toLocaleLowerCase(locale)}</text>
          </g>
        </g>

        <!-- Beat 6: the seats become the table's roles, with their shapes and labels. -->
        <g class="sc-seats">
          <circle class="sc-seat--you" cx="48" cy="118" r="13" />
          <text class="sc-seat__label" x="48" y="152" text-anchor="middle">{tr('table.you')}</text>
          <rect class="sc-seat--other" x="300" y="106" width="24" height="24" rx="2" />
          <text class="sc-seat__label" x="312" y="152" text-anchor="middle">{tr('table.other')}</text>
        </g>
      </svg>

      <div class="scene__text">
        <!-- Act 1's minimal entry (R4): the scene's opening words at beat 0, gone when the chat starts. -->
        {Astro.slots.has('intro') && <div class="scene__intro"><slot name="intro" /></div>}
        <ol class="scene__captions" aria-label={tr('scene.captions')}>
          {captions.map((caption) => <li class={`scene__caption scene__caption--${caption.beat}`}>{caption.text}</li>)}
        </ol>
      </div>

      <p class="scene__hint" aria-hidden="true">{tr('scene.hint')} ↓</p>
    </div>
  </div>
</div>

<style>
  /*
   * The still version: the default. Beat 5 as one drawing, the captions beside it as a numbered
   * list. Everything below this block that moves lives inside the gate at the end.
   */
  .scene {
    padding-inline: var(--gutter);
  }

  .scene__frame {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    justify-items: center;
    max-width: var(--table-max);
    margin: 0 auto;
    padding-block: var(--space-8);
  }

  @media (min-width: 48rem) {
    .scene__frame {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .scene__svg {
    display: block;
    width: 100%;
    max-width: 46rem;
    height: auto;
    /* B and C leave and enter through the side of the drawing, never past it. */
    overflow: hidden;
    font-family: var(--font-ui);
  }

  .scene__text {
    font-family: var(--font-prose);
    font-size: var(--step-0);
    line-height: var(--leading-body);
  }

  .scene__intro :global(p) {
    margin: 0 0 var(--space-4);
  }

  .scene__captions {
    margin: 0;
    padding-inline-start: 1.5em;
  }

  .scene__caption + .scene__caption {
    margin-top: var(--space-2);
  }

  .scene__hint {
    display: none;
  }

  /* The drawing. Neutral ink for A, B and C; the roles' colours and shapes only at beat 6. */
  .sc-table {
    fill: var(--color-surface-hover);
    stroke: var(--color-border);
    stroke-width: 1.5;
  }

  .sc-body,
  .sc-head {
    fill: var(--color-control);
  }

  .sc-letter {
    font-size: 13px;
    font-weight: 700;
    fill: var(--color-bg);
  }

  .sc-tag rect {
    fill: none;
    stroke: var(--color-fg);
    stroke-width: 1.25;
  }

  .sc-tag text {
    font-size: 10px;
    font-weight: 600;
    fill: var(--color-fg);
  }

  .sc-diamond {
    fill: var(--color-promise);
    stroke: var(--color-bg);
    stroke-width: 1.5;
  }

  .sc-die {
    filter: var(--shadow-die);
  }

  .sc-die__face {
    fill: var(--color-fg);
    stroke: var(--color-control);
    stroke-width: 1;
  }

  .sc-pips circle {
    fill: var(--color-bg);
  }

  .sc-bubble rect,
  .sc-bubble path {
    fill: var(--color-fg);
  }

  .sc-bubble__text {
    font-size: 13px;
    font-weight: 600;
    fill: var(--color-bg);
  }

  .sc-chips rect {
    fill: var(--color-surface-hover);
    stroke: var(--color-border);
  }

  .sc-chip__n {
    font-size: 16px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    fill: var(--color-fg);
  }

  .sc-chip__note {
    font-size: 10px;
    fill: var(--color-muted);
  }

  .sc-away {
    font-size: 10px;
    font-weight: 600;
    fill: var(--color-muted);
  }

  .sc-seat--you {
    fill: var(--color-you);
  }

  .sc-seat--other {
    fill: var(--color-other);
  }

  .sc-seat__label {
    font-size: 11px;
    font-weight: 700;
    fill: var(--color-fg);
  }

  /*
   * Movement happens on inner groups, so the outer groups keep their SVG positions: a CSS transform
   * on an element replaces its `transform` attribute. No animated element carries that attribute
   * (tests/scene.test.ts).
   */
  .sc-person,
  .sc-die,
  .sc-bubble,
  .sc-chips,
  .sc-seats,
  .sc-tag,
  .sc-diamond--a {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Beat 5, still: A decides; C sits in B's seat; B waits apart, faded; the die shows its face. */
  .sc-b {
    opacity: 0.5;
    transform: translate(10px, -74px) scale(0.72);
  }

  .sc-bubble,
  .sc-pips--before,
  .sc-seats {
    opacity: 0;
  }

  /* Once the visitor chooses, the still table turns to moment 1: the seats become the roles. */
  .scene[data-scene-state='played'] :is(.sc-person, .sc-chips) {
    opacity: 0;
  }

  .scene[data-scene-state='played'] .sc-seats {
    opacity: 1;
  }

  /*
   * The scroll-bound version (ADR 0020). Only where scroll timelines exist, motion is allowed and
   * scripting is on; everywhere else the still version above stays. Every keyframe stop is one of
   * sceneStops() in src/lib/table/scene.ts, as a percentage of the time the frame stays pinned.
   */
  @media (prefers-reduced-motion: no-preference) and (scripting: enabled) {
    @supports (animation-timeline: view()) {
      .scene__track {
        height: 500vh;
        height: 500svh;
        view-timeline: --scene block;
      }

      .scene__frame {
        position: sticky;
        top: 0;
        grid-template-columns: none;
        grid-template-rows: auto auto;
        /* The table sits high, so the first screen already shows A and B at it (beat 0). */
        align-content: start;
        height: 100vh;
        height: 100svh;
        max-width: none;
        padding-block: max(var(--space-4), 4svh) var(--space-12);
        /* The light fades out before the frame's edges, so it never draws a line at its top. */
        background: radial-gradient(ellipse 50% 40% at 50% 38%, var(--color-spot), transparent);
      }

      .scene__svg {
        max-height: 56svh;
      }

      /* The entry and every caption share one place under the table, and take turns in it. */
      .scene__text {
        display: grid;
        width: min(100%, 38rem);
        min-height: 5.5em;
        text-align: center;
        font-size: var(--step-1);
        line-height: var(--leading-tight);
      }

      .scene__intro,
      .scene__captions {
        grid-area: 1 / 1;
      }

      .scene__intro :global(p) {
        margin: 0;
      }

      .scene__captions {
        display: grid;
        padding: 0;
        list-style: none;
      }

      .scene__caption {
        grid-area: 1 / 1;
        align-self: start;
      }

      .scene__caption + .scene__caption {
        margin-top: 0;
      }

      .scene__hint {
        display: block;
        position: absolute;
        inset: auto 0 var(--space-6);
        margin: 0;
        text-align: center;
        font-family: var(--font-ui);
        font-size: var(--step-n1);
        font-weight: 600;
        color: var(--color-muted);
      }

      .sc-away {
        display: none;
      }

      .scene__hint,
      .scene__intro,
      .scene__caption,
      .sc-a,
      .sc-b,
      .sc-c,
      .sc-tag,
      .sc-diamond--a,
      .sc-die,
      .sc-pips--before,
      .sc-pips--after,
      .sc-bubble,
      .sc-bubble__text,
      .sc-chips,
      .sc-seats {
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --scene;
        animation-range: contain 0% contain 100%;
      }

      .scene__hint {
        animation-name: scene-hint;
      }

      .scene__intro {
        animation-name: scene-intro;
      }

      .scene__caption--1 {
        animation-name: scene-caption-talk;
      }

      .scene__caption--4 {
        animation-name: scene-caption-switch;
      }

      .scene__caption--5 {
        animation-name: scene-caption-die;
      }

      .scene__caption--6 {
        animation-name: scene-caption-yours;
      }

      .sc-a {
        animation-name: scene-a;
      }

      .sc-b {
        animation-name: scene-b;
      }

      .sc-c {
        animation-name: scene-c;
      }

      .sc-tag {
        animation-name: scene-tag;
      }

      .sc-diamond--a {
        animation-name: scene-promise;
      }

      .sc-bubble {
        animation-name: scene-bubble;
      }

      .sc-bubble__text {
        animation-name: scene-typing;
      }

      .sc-die {
        animation-name: scene-die;
      }

      .sc-pips--before {
        animation-name: scene-pips-before;
      }

      .sc-pips--after {
        animation-name: scene-pips-after;
      }

      .sc-chips {
        animation-name: scene-chips;
      }

      .sc-seats {
        animation-name: scene-seats;
      }
    }
  }

  /* Beat 0: a small sign to scroll, gone once the chat starts. */
  @keyframes scene-hint {
    0% {
      opacity: 1;
    }

    4%,
    100% {
      opacity: 0;
    }
  }

  /* Beat 0: act 1's entry, until the chat starts. */
  @keyframes scene-intro {
    0%,
    4% {
      opacity: 1;
      transform: none;
    }

    8%,
    100% {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }

  @keyframes scene-caption-talk {
    0%,
    8% {
      opacity: 0;
      transform: translateY(0.5rem);
    }

    10%,
    42% {
      opacity: 1;
      transform: none;
    }

    44%,
    100% {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }

  @keyframes scene-caption-switch {
    0%,
    44% {
      opacity: 0;
      transform: translateY(0.5rem);
    }

    46%,
    60% {
      opacity: 1;
      transform: none;
    }

    62%,
    100% {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }

  @keyframes scene-caption-die {
    0%,
    62% {
      opacity: 0;
      transform: translateY(0.5rem);
    }

    64%,
    80% {
      opacity: 1;
      transform: none;
    }

    82%,
    100% {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }

  @keyframes scene-caption-yours {
    0%,
    82% {
      opacity: 0;
      transform: translateY(0.5rem);
    }

    84%,
    100% {
      opacity: 1;
      transform: none;
    }
  }

  /* Beat 1: A writes; the bubble fills as the visitor scrolls. */
  @keyframes scene-bubble {
    0%,
    8% {
      opacity: 0;
      transform: translateY(8px);
    }

    20%,
    24% {
      opacity: 1;
      transform: translateY(0);
    }

    29%,
    100% {
      opacity: 0;
      transform: translateY(-6px) scale(0.9);
    }
  }

  @keyframes scene-typing {
    0%,
    8% {
      clip-path: inset(0 100% 0 0);
    }

    20%,
    100% {
      clip-path: inset(0 0 0 0);
    }
  }

  /* Beat 2: the promise stays, as a diamond on B's side. */
  @keyframes scene-promise {
    0%,
    24% {
      opacity: 0;
      transform: translate(-100px, -62px) scale(0.5);
    }

    29%,
    100% {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }
  }

  /* Beat 3: the roles are drawn; A decides. */
  @keyframes scene-tag {
    0%,
    34% {
      opacity: 0;
      transform: translateY(6px);
    }

    38%,
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Beat 4: B leaves with A's promise; C arrives with another one. Only A sees it. */
  @keyframes scene-b {
    0%,
    44% {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }

    52%,
    100% {
      opacity: 0;
      transform: translate(90px, 0) scale(1);
    }
  }

  @keyframes scene-c {
    0%,
    52% {
      opacity: 0;
      transform: translateX(90px);
    }

    58%,
    82% {
      opacity: 1;
      transform: translateX(0);
    }

    88%,
    100% {
      opacity: 0;
      transform: translateX(0);
    }
  }

  /* Beat 6: A, B and C leave. */
  @keyframes scene-a {
    0%,
    82% {
      opacity: 1;
    }

    88%,
    100% {
      opacity: 0;
    }
  }

  /* Beat 5: the die rolls with the scroll and lands on its face. */
  @keyframes scene-die {
    0%,
    62% {
      transform: translateY(0) rotate(0deg);
    }

    68% {
      transform: translateY(-44px) rotate(400deg);
    }

    74%,
    100% {
      transform: translateY(0) rotate(720deg);
    }
  }

  @keyframes scene-pips-before {
    0%,
    68% {
      opacity: 1;
    }

    74%,
    100% {
      opacity: 0;
    }
  }

  @keyframes scene-pips-after {
    0%,
    68% {
      opacity: 0;
    }

    74%,
    100% {
      opacity: 1;
    }
  }

  @keyframes scene-chips {
    0%,
    74% {
      opacity: 0;
      transform: translateY(6px);
    }

    78%,
    82% {
      opacity: 1;
      transform: translateY(0);
    }

    88%,
    100% {
      opacity: 0;
      transform: translateY(0);
    }
  }

  @keyframes scene-seats {
    0%,
    88% {
      opacity: 0;
      transform: scale(0.6);
    }

    94%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
