---
/**
 * Chapter 7's curve and its control (ADR 0023, interaction 9). A step chart built at build time from
 * src/data/curve.json (ADR 0010), readable without JavaScript, plus a visually hidden table of every
 * row. With JavaScript, a slider moves a cursor over the grid rows (./controller.ts).
 *
 * It sits on a paper card of the film, in the film's colours (src/lib/curve/film.ts, ADR 0027): the
 * lines in a light colour wear an ink casing. Partner-specific commitment and general guilt are one
 * wide gold band (they pay the same on every row). Personal guilt is a thinner ink line on that
 * band, centred on the same payoff, so the gold shows on both sides where they tie. The peak is a
 * ring above the line. /finding's chart of the guilt available is ./GuiltChart.astro.
 *
 * Render this only inside the lock (src/lib/lock.ts, ADR 0034). While the lock is closed, a build
 * resolves this file to ./Locked.astro (astro.config.mjs), so its markup, style, script and data
 * never reach dist/; `npm run verify:dist` checks that.
 */
import { FILM } from '../../lib/design/film';
import { useTranslations, type Locale } from '../../lib/i18n';
import { stepLine, xPercent, yPixel, type Frame, type Segment } from '../../lib/curve/chart';
import { payoffLevels, pullWindow, REASONS, type Reason } from '../../lib/curve/curve';
import { CURVE } from '../../lib/curve/data';
import { CASED, FILM_SERIES } from '../../lib/curve/film';
import { indexOf, pullsText, valueText } from '../../lib/curve/moment3';
import { curveStrings } from '../../lib/curve/strings';
import { fill } from '../../lib/template';

interface Props {
  locale: Locale;
  /** Unique on the page; prefixes every id inside the figure. */
  id: string;
}

const { locale, id } = Astro.props;
/** The series take the film's colours through the chart's own custom properties. */
const filmStyle = `--color-series-1: ${FILM[FILM_SERIES.personal]}; --color-series-2: ${FILM[FILM_SERIES.partner]}; --color-series-3: ${FILM[FILM_SERIES.general]};`;
const cased = (reason: Reason) => CASED.includes(reason);
const tr = useTranslations(locale);
const strings = curveStrings(tr);
const { rows, axis, peak } = CURVE;
const window = pullWindow(CURVE);
const levels = payoffLevels(CURVE);
const low = levels[0] ?? 0;
const high = levels.at(-1) ?? 0;

// Vertical layout in CSS px; x is a percentage of the plot width, so text never scales.
const frame: Frame = { zero: 200, top: 52, high };
const Y_ZERO = frame.zero;
const y = (payoff: number) => yPixel(payoff, frame);
const x = (trust: number) => `${xPercent(trust, axis)}%`;

const name: Record<Reason, string> = {
  personal: tr('curve.series.personal'),
  partner: tr('curve.series.partner'),
  general: tr('curve.series.general'),
};
// Partner-specific commitment and general guilt are the same payoff on every row, so they are one line.
// Personal guilt is drawn on top of that line, at the same y, thinner, so both stay visible.
const flat = stepLine(rows, 'partner');
const personal = stepLine(rows, 'personal');
const yTicks = [0, ...levels];
const xTicks = [axis.min, peak, axis.max];
const start = indexOf(rows, peak);
const startRow = rows[start];
const summary = fill(tr('curve.summary'), { min: axis.min, max: axis.max, high, low, from: window.from, to: window.to, peak });
const flatLabel = fill(tr('curve.flat'), { high });
const personalLabel = fill(tr('curve.label.personal'), { high, low });
const clientRows = JSON.stringify(rows);
const placed = (segment: Segment) => ({
  x1: x(segment.x1),
  x2: x(segment.x2),
  y1: y(segment.y1),
  y2: y(segment.y2),
});
/** The cursor's line starts just above the shared payoff, so it never runs through the peak's ring. */
const cursorTop = y(high) - 4;
/** The peak is a ring above the line, clear of the cursor's filled dot even when both sit at the peak. */
const peakRing = y(high) - 18;
---

<figure class="curve curve--film" style={filmStyle} id={id} data-locked-content data-curve data-rows={clientRows} data-axis={JSON.stringify(axis)} data-frame={JSON.stringify(frame)} data-start={start} data-strings={JSON.stringify(strings)} aria-labelledby={`${id}-caption`}>
  <p class="cv-axis-title" aria-hidden="true">{tr('curve.axis.y')}</p>
  <ul class="cv-direct">
    <li>
      <svg class="cv-swatch" viewBox="0 0 20 8" aria-hidden="true" focusable="false">
        {cased('partner') && <line class="cv-case cv-case--partner" x1="0" x2="20" y1="4" y2="4" />}
        <line class="cv-key cv-line--partner" x1="0" x2="20" y1="4" y2="4" />
      </svg>
      <span>{flatLabel}</span>
    </li>
    <li>
      <svg class="cv-swatch" viewBox="0 0 20 8" aria-hidden="true" focusable="false">
        <line class="cv-key cv-line--personal" x1="0" x2="20" y1="4" y2="4" />
      </svg>
      <span>{personalLabel}</span>
    </li>
    <li>
      <svg class="cv-swatch cv-swatch--ring" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <circle class="cv-peak" cx="8" cy="8" r="4.5" />
      </svg>
      <span>{tr('curve.peak')}</span>
    </li>
  </ul>
  <div class="cv-plot">
    <svg class="cv-svg" width="100%" height="232" role="img" aria-label={summary}>
      {yTicks.map((tick) => <line class="cv-grid" x1="0" x2="100%" y1={y(tick)} y2={y(tick)} />)}
      {yTicks.map((tick) => <text class="cv-tick" x="-8" y={y(tick) + 4} text-anchor="end">{tick}</text>)}
      {rows.map((row) => <line class="cv-minor" x1={x(row.trust)} x2={x(row.trust)} y1={Y_ZERO} y2={Y_ZERO + 4} />)}
      {
        xTicks.map((tick) => (
          <>
            <line class="cv-major" x1={x(tick)} x2={x(tick)} y1={Y_ZERO} y2={Y_ZERO + 7} />
            <text class="cv-tick" x={x(tick)} y={Y_ZERO + 22} text-anchor={tick === axis.min ? 'start' : tick === axis.max ? 'end' : 'middle'}>{tick}</text>
          </>
        ))
      }

      <circle class="cv-peak" cx={x(peak)} cy={peakRing} r="5" />

      {
        flat.map((segment) => (
          <>
            {cased('partner') && <line class="cv-case cv-case--partner" {...placed(segment)} />}
            <line class="cv-line cv-line--partner" {...placed(segment)} />
          </>
        ))
      }
      {personal.map((segment) => <line class="cv-line cv-line--personal" {...placed(segment)} />)}

      <g class="cv-cursor" data-slot="cursor">
        <line data-slot="cursor-line" x1={x(peak)} x2={x(peak)} y1={cursorTop} y2={Y_ZERO} />
        <circle data-slot="cursor-dot" cx={x(peak)} cy={y(startRow?.payoff.personal ?? high)} r="5" />
      </g>
    </svg>
    <p class="cv-axis-title cv-axis-title--x" aria-hidden="true">{tr('curve.axis.x')}</p>
  </div>

  <div class="cv-live" data-live hidden>
    <div class="cv-control">
      <label class="cv-control__label" for={`${id}-slider`}>{tr('curve.slider.label')}</label>
      <span class="cv-control__value" data-slot="trust">{startRow && fill(strings['curve.trust.value'], { n: startRow.trust })}</span>
      <input class="cv-slider" id={`${id}-slider`} type="range" min="0" max={rows.length - 1} step="1" value={start} aria-valuetext={startRow && valueText(strings, startRow)} />
    </div>
    <dl class="cv-readout">
      {
        REASONS.map((reason) => (
          <div class="cv-readout__item">
            <dt>
              <svg class="cv-swatch" viewBox="0 0 20 8" aria-hidden="true" focusable="false">
                {reason !== 'personal' && cased('partner') && <line class="cv-case cv-case--partner" x1="0" x2="20" y1="4" y2="4" />}
                <line class={`cv-key cv-line--${reason === 'personal' ? 'personal' : 'partner'}`} x1="0" x2="20" y1="4" y2="4" />
              </svg>
              {name[reason]}
            </dt>
            <dd data-slot={reason}>{startRow?.payoff[reason]}</dd>
          </div>
        ))
      }
    </dl>
    <p class="cv-pulls" data-slot="pulls">{startRow && pullsText(strings, startRow)}</p>
    <p class="visually-hidden" role="status" aria-live="polite" data-slot="status"></p>
  </div>

  {/* A table ignores width and overflow, so the div does the hiding and keeps the page from scrolling sideways. */}
  <div class="visually-hidden">
  <table>
    <caption>{tr('curve.table.caption')}</caption>
    <thead>
      <tr>
        <th scope="col">{tr('curve.table.trust')}</th>
        {REASONS.map((reason) => <th scope="col">{name[reason]}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">{fill(strings['curve.trust.value'], { n: row.trust })}</th>
            {REASONS.map((reason) => <td>{row.payoff[reason]}</td>)}
          </tr>
        ))
      }
    </tbody>
  </table>
  </div>

  <figcaption class="cv-caption" id={`${id}-caption`}>{tr('curve.caption')}</figcaption>
</figure>

<script>
  import { mountAll } from './controller';

  mountAll();
</script>

<style>
  .curve {
    margin: var(--space-8) auto;
    padding: var(--space-4);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-ui);
    font-size: var(--step-n1);
    line-height: var(--leading-ui);
  }

  @media (min-width: 40rem) {
    .curve {
      padding: var(--space-6);
    }
  }

  .cv-axis-title {
    margin: 0 0 var(--space-2);
    font-size: var(--step-n2);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cv-axis-title--x {
    margin: var(--space-2) 0 0;
    text-align: center;
  }

  /* Room on the left for the payoff ticks, which sit outside the plot. */
  .cv-plot {
    padding-inline: 1.5rem 0.25rem;
  }

  .cv-svg {
    display: block;
    overflow: visible;
    font-size: var(--step-n2);
    font-variant-numeric: tabular-nums;
  }

  .cv-grid {
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .cv-minor,
  .cv-major {
    stroke: var(--color-control);
    stroke-width: 1;
  }

  .cv-tick {
    fill: var(--color-muted);
  }

  /* Labels sit above the plot and wrap, so the long merged-line sentence fits at 320 px. */
  .cv-direct {
    display: grid;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    padding: 0;
    list-style: none;
  }

  .cv-direct li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    min-width: 0;
  }

  /* The peak is a ring, not a bar, so it stays distinct from the cursor's line and filled dot. */
  .cv-peak {
    fill: none;
    stroke: var(--color-fg);
    stroke-width: 1.5;
  }

  .cv-line,
  .cv-key {
    fill: none;
    stroke-linecap: square;
  }

  .cv-line--personal {
    stroke: var(--color-series-1);
  }

  .cv-line--partner {
    stroke: var(--color-series-2);
  }

  /* A wide gold band, then a thin ink line centred on the same payoff, so the gold shows both sides. */
  .cv-svg .cv-line--partner {
    stroke-width: 11;
  }

  .cv-svg .cv-line--personal {
    stroke-width: 2.5;
  }

  .cv-swatch .cv-line--partner {
    stroke-width: 5;
  }

  .cv-swatch .cv-line--personal {
    stroke-width: 1.5;
  }

  /* The cursor appears only once the script runs (data-on). */
  .cv-cursor:not([data-on]) {
    display: none;
  }

  .cv-cursor line {
    stroke: var(--color-fg);
    stroke-width: 1.5;
  }

  .cv-cursor circle {
    fill: var(--color-series-1);
    stroke: var(--color-surface);
    stroke-width: 2;
  }

  .cv-live {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-border);
  }

  .cv-control {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
  }

  .cv-control__label {
    font-weight: 600;
  }

  .cv-control__value {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .cv-slider {
    grid-column: 1 / -1;
    width: 100%;
    min-height: var(--target-min);
    margin: 0;
    accent-color: var(--color-fg);
    cursor: pointer;
  }

  /* Two aligned columns, reason and payoff, at every width. */
  .cv-readout {
    display: grid;
    grid-template-columns: auto auto;
    justify-content: start;
    align-items: baseline;
    gap: var(--space-2) var(--space-6);
    margin: 0;
  }

  .cv-readout__item {
    display: contents;
  }

  .cv-readout dt {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-muted);
  }

  .cv-readout dd {
    margin: 0;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .cv-swatch {
    width: 1.25rem;
    height: 0.5rem;
    overflow: visible;
    flex: none;
  }

  .cv-direct .cv-swatch {
    margin-top: 0.35em;
  }

  .cv-direct .cv-swatch--ring {
    width: 0.9rem;
    height: 0.9rem;
    margin-top: 0.1em;
  }

  .cv-pulls {
    margin: 0;
    font-weight: 600;
  }

  .cv-caption {
    margin: var(--space-4) 0 0;
    color: var(--color-muted);
  }

  /*
   * On a card of the film (chapter 7): the card is the paper, so the figure drops its own frame, and
   * the chart's tokens take the film's ink and paper. Light lines are cased in ink, as the cast is.
   */
  .curve--film {
    --color-surface: var(--film-card);
    --color-fg: var(--film-ink);
    --color-muted: var(--film-card-muted);
    --color-border: rgb(29 27 58 / 0.16);
    --color-control: var(--film-card-muted);
    margin: var(--space-2) 0 0;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 0;
    font-family: var(--font-body, system-ui, sans-serif);
  }

  .curve--film .cv-live {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
  }

  .curve--film .cv-slider {
    accent-color: var(--film-ink);
  }

  .curve--film .cv-caption {
    margin-top: var(--space-3);
    font-size: 0.85rem;
  }

  .cv-case {
    fill: none;
    stroke: var(--film-ink);
  }

  .cv-case--partner {
    stroke-linecap: square;
  }

  .cv-svg .cv-case--partner {
    stroke-width: 15;
  }

  .cv-swatch .cv-case--partner {
    stroke-width: 7;
  }

</style>
