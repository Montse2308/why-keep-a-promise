---
/**
 * One of the cast as a paper cut-out (ADR 0027): an ink contour, a paper rim, the fill and a face in
 * ink. The face's parts carry classes so the film's script can change the mood in place; the build
 * draws the mood it is given, so a still frame and the film look the same.
 */
import { FILM } from '../../lib/design/film';
import { FACES, type Mood } from '../../lib/film/faces';

interface Props {
  kind: 'circle' | 'square' | 'triangle';
  mood?: Mood;
  /** Id of the SVG filter that casts the paper's shadow, unique per drawing. */
  shadow: string;
  class?: string;
}

const { kind, mood = 'neutral', shadow, class: className } = Astro.props;
const face = FACES[mood];
const fill = { circle: FILM.you, square: FILM.other, triangle: FILM.new }[kind];
const [lookX, lookY] = face.look;
// The triangle is narrower at the top: its face sits lower and a little smaller.
const faceTransform = kind === 'triangle' ? 'translate(0 16) scale(0.74)' : undefined;
---

<g class:list={['cut', `cut--${kind}`, className]} data-kind={kind}>
  <g filter={`url(#${shadow})`}>
    {kind === 'circle' && <circle r="58" fill={FILM.ink} stroke={FILM.ink} stroke-width="13" />}
    {kind === 'circle' && <circle r="58" fill={fill} stroke={FILM.rim} stroke-width="7" />}
    {kind === 'square' && <rect x="-56" y="-56" width="112" height="112" rx="18" fill={FILM.ink} stroke={FILM.ink} stroke-width="13" stroke-linejoin="round" />}
    {kind === 'square' && <rect x="-56" y="-56" width="112" height="112" rx="18" fill={fill} stroke={FILM.rim} stroke-width="7" stroke-linejoin="round" />}
    {kind === 'triangle' && <path d="M0 -66 L62 50 L-62 50 Z" fill={FILM.ink} stroke={FILM.ink} stroke-width="13" stroke-linejoin="round" />}
    {kind === 'triangle' && <path d="M0 -66 L62 50 L-62 50 Z" fill={fill} stroke={FILM.rim} stroke-width="7" stroke-linejoin="round" />}
  </g>
  <g class="face" transform={faceTransform}>
    <g class="face__open" visibility={face.closedEyes ? 'hidden' : 'visible'}>
      <ellipse cx="-21" cy="-10" rx="14" ry="16" fill="#fff" />
      <ellipse cx="21" cy="-10" rx="14" ry="16" fill="#fff" />
      <g class="face__pupils" transform={`translate(${lookX} ${lookY})`}>
        <circle cx="-21" cy="-8" r="7" fill={FILM.ink} />
        <circle cx="21" cy="-8" r="7" fill={FILM.ink} />
        <circle cx="-18" cy="-11" r="2.2" fill="#fff" />
        <circle cx="24" cy="-11" r="2.2" fill="#fff" />
      </g>
    </g>
    <path class="face__closed" d="M-33 -8 Q-21 -22 -9 -8 M9 -8 Q21 -22 33 -8" fill="none" stroke={FILM.ink} stroke-width="5" stroke-linecap="round" visibility={face.closedEyes ? 'visible' : 'hidden'} />
    <path class="face__brow-l" d={face.brows[0]} fill="none" stroke={FILM.ink} stroke-width="5" stroke-linecap="round" />
    <path class="face__brow-r" d={face.brows[1]} fill="none" stroke={FILM.ink} stroke-width="5" stroke-linecap="round" />
    <path class="face__mouth" d={face.mouth} fill="none" stroke={FILM.ink} stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
    <g class="face__blush" fill="#ff8fa3" opacity={face.blush ? 0.6 : 0}>
      <ellipse cx="-34" cy="12" rx="9" ry="5" />
      <ellipse cx="34" cy="12" rx="9" ry="5" />
    </g>
    <path class="face__sweat" d="M46 -40 q9 15 0 22 q-9 -7 0 -22z" fill="#8fd3ff" stroke="#fff" stroke-width="3" opacity={face.sweat ? 1 : 0} />
    <path class="face__tear" d="M-30 4 q5 10 0 14 q-5 -4 0 -14z" fill="#8fd3ff" stroke="#fff" stroke-width="2" opacity={face.tear ? 1 : 0} />
  </g>
</g>
