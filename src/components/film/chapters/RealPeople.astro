---
/**
 * Chapter 6, the real people (ADR 0021, ADR 0023): what the people in Vanberg's (2008) experiment
 * did. Before each figure, the visitor moves a bar to guess it; then the sign over the table shows
 * it: 73 % of rounds rolled after a promise with the same partner, 54 % with a new partner, from the
 * exact counts. What the recipients expected barely moved, 70 against 68, and Vanberg's conclusion
 * closes the chapter. The guess is set beside the figure and never judged (ADR 0023).
 */
import { beat, chapter } from '../../../lib/chapters';
import { FILM } from '../../../lib/design/film';
import { GUESS_START, GUESSES, truth } from '../../../lib/film/guess';
import { KEY_POSE, stageAt } from '../../../lib/film/stage';
import { FILM_VALUES } from '../../../lib/film/values';
import { useTranslations, type Locale } from '../../../lib/i18n';
import { roundOf } from '../../../lib/pd/round';
import { outcomeOf } from '../../../lib/table/decision';
import { fill } from '../../../lib/template';
import Beat from '../Beat.astro';
import Chapter from '../Chapter.astro';
import Ticket from '../Ticket.astro';
import Tickets from '../Tickets.astro';

interface Props {
  locale: Locale;
  title: string;
  captions: ReadonlyMap<string, string>;
}

const { locale, title, captions } = Astro.props;
const tr = useTranslations(locale);
const guessBeats = GUESSES.map((guess) => ({ ...guess, beat: beat('real-people', `guess-${guess.id}`), real: truth(guess.id) }));
const expected = beat('real-people', 'expected');
const conclusion = beat('real-people', 'conclusion');
const percent = (n: number | string) => fill(tr('film.real-people.percent'), { n });

// The storyboard's still frame: both signs down, with their figures and what was expected.
const still = stageAt(
  KEY_POSE['real-people'] ?? 0,
  { promised: true, round: roundOf('cooperate'), chat: 'promise', decision: { phase: 'outcome', ...outcomeOf('roll', 4) } },
  false,
  true,
);
---

<Chapter locale={locale} id="real-people" labelledby="real-people-title" still={still} stillLabel={fill(tr('film.real-people.still'), FILM_VALUES)}>
  {
    guessBeats.map(({ id, beat: b, real }, i) => (
      <Beat id={b.id} screens={b.screens} caption={captions.get(b.id)}>
        {i === 0 && (
          <h2 slot="top" id="real-people-title" class="card__chapter">
            <span>{fill(tr('film.chapter'), { n: chapter('real-people').number })}</span>
            <span aria-hidden="true">·</span>
            <span>{title}</span>
          </h2>
        )}
        <div class="guess" data-guess={id}>
          <label class="card__ask" for={`guess-${id}`}>{tr('film.real-people.guess.label')}</label>
          <div class="guess__bar">
            <input
              id={`guess-${id}`}
              class="guess__range"
              type="range"
              min="0"
              max="100"
              step="1"
              value={GUESS_START}
              aria-valuetext={percent(GUESS_START)}
              data-guess-range
              data-percent={tr('film.real-people.percent')}
            />
            <svg class="guess__truth" style={`--at: ${real}`} viewBox="-12 -16 24 32" aria-hidden="true" data-guess-truth>
              <path d="M0 14 L0 -6" stroke={FILM.ink} stroke-width="3" />
              <path d={id === 'same' ? 'M-8 -14 H8 V2 H-8 Z' : 'M0 -15 L9 2 L-9 2 Z'} fill={id === 'same' ? FILM.other : FILM.new} stroke={FILM.ink} stroke-width="2.5" stroke-linejoin="round" />
            </svg>
          </div>
          <p class="bet__ends" aria-hidden="true"><span>{percent(0)}</span><span>{percent(100)}</span></p>
          <Tickets label={tr('film.real-people.guess.label')} data-guess-tickets="">
            <Ticket label={tr('film.real-people.guess.see')} detail={fill(tr('film.real-people.guess.yours'), { n: GUESS_START })} data-guess-see data-yours={tr('film.real-people.guess.yours')}>
              <svg slot="icon" viewBox="-24 -24 48 48">
                <rect x="-17" y="-13" width="34" height="26" rx="4" fill={FILM.card} stroke={FILM.ink} stroke-width="3" />
                <path d="M-11 -13 V-22 M11 -13 V-22" stroke={FILM.ink} stroke-width="2.5" />
                <text y="7" text-anchor="middle" class="guess__icon" fill={FILM.ink}>?</text>
              </svg>
            </Ticket>
          </Tickets>
          <p class="card__out" aria-live="polite" data-guess-out data-said={fill(tr('film.real-people.guess.out'), { real, guess: '{guess}' })}></p>
        </div>
        <p class="card__noscript">{fill(tr('film.real-people.guess.noscript'), { real })}</p>
      </Beat>
    ))
  }

  <Beat id={expected.id} screens={expected.screens} caption={captions.get(expected.id)} />
  <Beat id={conclusion.id} screens={conclusion.screens} caption={captions.get(conclusion.id)} />
</Chapter>

<style>
  .guess {
    display: none;
    gap: var(--space-2);
  }

  :global(html.js) .guess {
    display: grid;
  }

  .guess__bar {
    position: relative;
  }

  .guess__range {
    width: 100%;
    height: 2.75rem;
    margin: 0;
    accent-color: var(--film-you);
    cursor: pointer;
  }

  .guess__range:focus-visible {
    outline: 3px solid var(--film-you);
    outline-offset: 4px;
  }

  /* Where the real figure sits on the bar, once it shows: the sign's own shape, over the track. */
  .guess__truth {
    position: absolute;
    top: -0.9rem;
    left: calc(0.6rem + (100% - 1.2rem) * var(--at) / 100);
    width: 1.3rem;
    height: 1.75rem;
    translate: -50% 0;
    pointer-events: none;
  }

  .guess:not([data-seen]) .guess__truth {
    display: none;
  }

  .guess__icon {
    font-family: var(--font-display, Georgia, serif);
    font-weight: 900;
    font-size: 20px;
  }

  .bet__ends {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: calc(-1 * var(--space-2));
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--film-card-muted);
  }
</style>
