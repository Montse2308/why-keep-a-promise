---
/**
 * The film (ADR 0021, ADR 0025): the home's chapters on one paper stage. Astro renders a storyboard
 * first: each chapter as a still frame with its cards, readable without JavaScript. When the page has
 * JavaScript (`html.js`, set before first paint), the stage sticks to the screen, the chapters'
 * beats scroll over it, and ./film.ts moves the camera, the light and the cast with the native scroll.
 *
 * The nine chapters render in order (src/lib/chapters.ts), and the notebook's footer follows the
 * film. Chapter 7's captions after its lock mark are the finding (ADR 0034): they go, as written, to
 * the one component that may render them.
 */
import { getCollection } from 'astro:content';
import { BUILT, CHAPTERS, LOCKED_BEATS, type ChapterId } from '../../lib/chapters';
import { FILM } from '../../lib/design/film';
import { externalLinks } from '../../lib/external';
import { splitAtLock, splitBeats } from '../../lib/film/captions';
import { LAST_CHAPTER } from '../../lib/film/progress';
import { stageAt } from '../../lib/film/stage';
import { BUILT_SPAN } from '../../lib/film/timeline';
import { FILM_VALUES } from '../../lib/film/values';
import { fill } from '../../lib/template';
import { useTranslations, type Locale } from '../../lib/i18n';
import Arrival from './chapters/Arrival.astro';
import Blackout from './chapters/Blackout.astro';
import Closing from './chapters/Closing.astro';
import Fold from './chapters/Fold.astro';
import MyResearch from './chapters/MyResearch.astro';
import RealPeople from './chapters/RealPeople.astro';
import Talk from './chapters/Talk.astro';
import TwoRooms from './chapters/TwoRooms.astro';
import TwoVoices from './chapters/TwoVoices.astro';
import World from './World.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = useTranslations(locale);
// The progress in words, for a screen reader: the chapter's number as its card says it, of the last one.
const progressLine = (n: number | string) => fill(tr('film.progress'), { n, last: LAST_CHAPTER });

// Each built chapter's captions, from src/content/chapters/<locale>/, split by beat.
const entries = await getCollection('chapters', (entry) => entry.id.startsWith(`${locale}/`));
// Numbers in the captions are placeholders, filled from the code (src/lib/film/values.ts). Only the
// open part: the finding's placeholders are the curve's, and only its component fills them.
const locked = new Set(LOCKED_BEATS.map((b) => b.id));
const chapters = new Map(
  BUILT.map((c) => {
    const entry = entries.find((candidate) => candidate.data.chapter === c.id);
    if (!entry?.rendered) throw new Error(`No captions for chapter "${c.id}" in ${locale}`);
    const parts = splitAtLock(externalLinks(entry.rendered.html, locale));
    const open = c.beats.filter((b) => !(c.id === 'my-research' && locked.has(b.id)));
    const beats = splitBeats(fill(parts.open, FILM_VALUES), open.map((b) => b.id));
    return [c.id, { title: entry.data.title, captions: beats, locked: parts.locked }] as const;
  }),
);
const of = (id: ChapterId) => {
  const found = chapters.get(id);
  if (!found) throw new Error(`Chapter "${id}" is not built`);
  return found;
};
---

<section
  class="film"
  aria-label={tr('film.label')}
  data-film
  data-from={BUILT_SPAN.from}
  data-to={BUILT_SPAN.to}
  data-thread-tied={tr('film.thread.tied')}
  data-thread-kept={tr('film.thread.kept')}
  data-thread-broken={tr('film.thread.broken')}
  data-thread-none={tr('film.thread.none')}
  data-progress={progressLine('{n}')}
>
  <div class="film__stage">
    <World locale={locale} uid="live" view={stageAt(0, { promised: null }, false, false)} live />
    <div class="film__paper" aria-hidden="true" data-paper></div>
    <!-- What the cards leave free of the stage; ./film.ts has the camera frame the shot in it. -->
    <div class="film__free" aria-hidden="true" data-free></div>
  </div>

  <!-- The film's corner, over the stage and the chapters, so a card leaving at the top passes under it. -->
  <div class="film__corner">
    <div class="film__controls">
      <div class="film__spool">
        <svg viewBox="-24 -24 48 48" aria-hidden="true" data-spool="none">
          <rect x="-15" y="-19" width="30" height="7" rx="3" fill={FILM['table-front']} stroke={FILM.ink} stroke-width="2.5" />
          <rect x="-15" y="12" width="30" height="7" rx="3" fill={FILM['table-front']} stroke={FILM.ink} stroke-width="2.5" />
          <rect x="-10" y="-12" width="20" height="24" fill={FILM.rim} stroke={FILM.ink} stroke-width="2.5" />
          <g class="film__spool-thread">
            <rect x="-10" y="-12" width="20" height="24" fill={FILM.thread} stroke={FILM.ink} stroke-width="2.5" />
            <path d="M-10 -6 H10 M-10 0 H10 M-10 6 H10" stroke={FILM['thread-edge']} stroke-width="1.5" />
          </g>
          <path class="film__spool-cut" d="M-14 3 L14 -3" stroke={FILM.rim} stroke-width="5" />
          <path class="film__spool-cut" d="M-14 3 L14 -3" stroke={FILM.ink} stroke-width="1.5" stroke-dasharray="3 3" />
        </svg>
        <div class="film__spool-text">
          <p aria-live="polite" data-spool-label>{tr('film.thread.none')}</p>
          <!-- The film's progress (./film.ts): passive, never focused; a screen reader reads the chapter in words. -->
          <p class="film__progress">
            <span class="visually-hidden" data-progress-label>{progressLine(0)}</span>
            <span class="film__beads" aria-hidden="true">{CHAPTERS.map(() => <span class="film__bead" data-bead />)}</span>
          </p>
        </div>
      </div>
      <!-- Sound (ADR 0025): off until pressed, and only where the browser has Web Audio (./film.ts unhides it). -->
      <button type="button" class="film__sound" aria-pressed="false" hidden data-sound>
        <svg viewBox="-12 -12 24 24" aria-hidden="true">
          <path d="M-9 -3.5 H-5 L1 -8.5 V8.5 L-5 3.5 H-9 Z" fill={FILM.thread} stroke={FILM.ink} stroke-width="1.8" stroke-linejoin="round" />
          <path class="film__sound-on" d="M4.5 -4 Q7.5 0 4.5 4 M7 -7.5 Q12 0 7 7.5" fill="none" stroke={FILM.ink} stroke-width="1.8" stroke-linecap="round" />
          <path class="film__sound-off" d="M4.5 -3.5 L10.5 3.5 M10.5 -3.5 L4.5 3.5" fill="none" stroke={FILM.ink} stroke-width="1.8" stroke-linecap="round" />
        </svg>
        <span class="film__sound-label">{tr('film.sound')}</span>
      </button>
    </div>
  </div>

  <div class="film__chapters">
    <Arrival locale={locale} captions={of('arrival').captions} />
    <TwoRooms locale={locale} {...of('two-rooms')} />
    <Talk locale={locale} {...of('talk')} />
    <Fold locale={locale} {...of('fold')} />
    <TwoVoices locale={locale} {...of('two-voices')} />
    <Blackout locale={locale} {...of('blackout')} />
    <RealPeople locale={locale} {...of('real-people')} />
    <MyResearch locale={locale} {...of('my-research')} />
    <Closing locale={locale} {...of('closing')} />
  </div>
  <div class="film__hold" aria-hidden="true"></div>
  <div class="film__fade" aria-hidden="true"></div>
</section>

<script>
  import { start } from './film';
  start();
</script>

<style>
  .film {
    position: relative;
    /* A card swiped or flying off the deck never widens the page; clip keeps the stage sticky. */
    overflow-x: clip;
    color: var(--film-ink);
    font-family: var(--font-body, system-ui, sans-serif);
    background: linear-gradient(#ffc58f, #ffe6cf);
  }

  /* While the film plays its memory back (ADR 0029), the choices are simply there: nothing moves. */
  .film[data-film-replaying] :global(*) {
    transition: none !important;
    animation: none !important;
  }

  /* Storyboard (no JavaScript): the chapters, one after another; no live stage. */
  .film__stage {
    display: none;
  }

  .film__fade {
    height: 8rem;
    background: linear-gradient(#86ae98, var(--color-bg));
  }

  /* The film (JavaScript): the stage sticks, the chapters' beats scroll over it. */
  :global(html.js) .film {
    background: none;
  }

  :global(html.js) .film__stage {
    display: block;
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  /*
   * The chapters lie over the whole stage, mostly transparent: they let a click or a tap through to
   * the stage, and only their cards take them (Beat.astro).
   */
  :global(html.js) .film__chapters {
    position: relative;
    margin-top: -100vh;
    margin-top: -100svh;
    pointer-events: none;
  }

  /*
   * The film's last frame holds after the credits have rolled by: the stage stays stuck, at the end of
   * the film, for this much more of the native scroll, before the page goes on.
   */
  .film__hold {
    display: none;
  }

  :global(html.js) .film__hold {
    display: block;
    height: 100vh;
    height: 100svh;
  }

  /* With the film, the stage's own paper takes the fade's place (below). */
  :global(html.js) .film__fade {
    display: none;
  }

  /*
   * The end: over the film's last screen the floor melts into the page's paper, grain and all, from
   * under the cast down, so the stage leaves the footer's paper behind and not a strip of empty floor.
   * ./film.ts sets its opacity; only that changes, on its own layer, so the scene is not painted
   * again for it. It lies under the cards and the corner.
   */
  .film__paper {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background-color: var(--color-bg);
    background-image: var(--paper-grain);
    -webkit-mask-image: linear-gradient(transparent 56%, #000 95%);
    mask-image: linear-gradient(transparent 56%, #000 95%);
    will-change: opacity;
  }

  /*
   * The part of the stage the cards leave free: all of it, except with a phone held sideways
   * (ADR 0031), where the cards sit at the left (Beat.astro) under the corner, and the camera frames
   * the screen right of them and below the corner's row, where the notebook's button is. Never
   * seen; ./film.ts reads where it lies.
   */
  .film {
    --side-card: 44vw;
    /* Below the corner's row: the spool and the sound. */
    --side-top: calc(var(--space-3) + env(safe-area-inset-top, 0px) + var(--target-min) + var(--space-3));
  }

  .film__free {
    position: absolute;
    inset: 0;
    visibility: hidden;
    pointer-events: none;
  }

  @media (orientation: landscape) and (max-height: 500px) {
    .film__free {
      top: var(--side-top);
      left: calc(max(var(--gutter), env(safe-area-inset-left, 0px)) + var(--side-card));
    }
  }

  /*
   * The film's own corner: the spool, and the sound beside it. Its layer sticks like the stage and
   * lies over the chapters, so a card on its way out at the top slides under the corner, as under the
   * notebook's button; the layer lets every click through but the sound's.
   */
  .film__corner {
    display: none;
  }

  :global(html.js) .film__corner {
    display: block;
    position: sticky;
    top: 0;
    z-index: 1;
    height: 100vh;
    height: 100svh;
    margin-top: -100vh;
    margin-top: -100svh;
    pointer-events: none;
  }

  .film__controls {
    position: absolute;
    top: calc(var(--space-3) + env(safe-area-inset-top, 0px));
    left: var(--gutter);
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .film__spool {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-1) var(--space-3) var(--space-1) var(--space-1);
    border-radius: 999px;
    background: var(--film-card);
    box-shadow: 0 4px 14px rgb(40 30 60 / 0.2);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .film__spool svg {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
  }

  .film__spool-text {
    display: grid;
    gap: 3px;
  }

  .film__spool-text p {
    margin: 0;
  }

  /*
   * The progress: a thin thread with a bead per chapter, under the spool's words. Each bead fills from
   * the left as the film goes through its chapter (./film.ts sets `--fill`).
   */
  /* As wide as its beads, so the thread ends at the last one even under a label on two lines. */
  .film__beads {
    position: relative;
    display: flex;
    gap: 3px;
    width: max-content;
  }

  .film__beads::before {
    content: '';
    position: absolute;
    inset: 50% 2px auto;
    height: 1.5px;
    margin-top: -0.75px;
    background: var(--film-ink);
    opacity: 0.35;
  }

  .film__bead {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--film-card);
    box-shadow: inset 0 0 0 1.5px var(--film-ink);
  }

  .film__bead::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--film-ink);
    transform: scaleX(var(--fill, 0));
    transform-origin: left;
  }

  .film__sound {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    box-sizing: border-box;
    min-width: var(--target-min);
    min-height: var(--target-min);
    margin: 0;
    padding: 0 var(--space-3) 0 var(--space-2);
    border: 2px solid transparent;
    border-radius: 999px;
    background: var(--film-card);
    box-shadow: 0 4px 14px rgb(40 30 60 / 0.2);
    color: var(--film-ink);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .film__sound[hidden] {
    display: none;
  }

  .film__sound:hover {
    border-color: var(--film-ink);
  }

  .film__sound:focus-visible {
    outline: 3px solid var(--film-ink);
    outline-offset: 2px;
  }

  .film__sound svg {
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
  }

  .film__sound[aria-pressed='true'] .film__sound-off,
  .film__sound[aria-pressed='false'] .film__sound-on {
    display: none;
  }

  /*
   * A phone: the sound is drawn alone, its name for screen readers, beside the spool. The first
   * screen's top row holds the language link and the title spans the phone, so the button shows once
   * the title has gone (./film.ts); by then the corner has scrolled away.
   */
  @media (max-width: 30rem) {
    .film[data-title='shown'] .film__sound {
      visibility: hidden;
    }

    .film__sound {
      padding: 0;
    }

    .film__sound-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* A phone held sideways (ADR 0031): the top row also holds the language link; the sound is drawn alone. */
  @media (orientation: landscape) and (max-height: 500px) {
    .film__sound {
      padding: 0;
    }

    .film__sound-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* A narrow phone: the spool's words take two lines, so the corner's language link and the notebook fit beside it. */
  @media (max-width: 24rem) {
    .film__spool [data-spool-label] {
      max-width: 7.25rem;
      line-height: 1.15;
    }
  }

  .film__spool svg[data-spool='none'] .film__spool-thread {
    opacity: 0;
  }

  /* A broken promise: the spool keeps its thread, cut through the middle. */
  .film__spool-cut {
    display: none;
  }

  .film__spool svg[data-spool='broken'] .film__spool-cut {
    display: inline;
  }
</style>
