---
/**
 * The paper diorama (ADR 0027), drawn at one point of the film. The film's live stage draws it once
 * and its script moves it; the storyboard draws one still frame per chapter at its key pose, with
 * only what that pose shows. Parts the script changes carry `data-part`, so nothing depends on ids,
 * which differ per drawing.
 */
import { FILM } from '../../lib/design/film';
import { frame, viewBoxAttribute } from '../../lib/film/camera';
import { brokenBetween, threadBetween, WORLD, type StageView } from '../../lib/film/stage';
import { bubbleTransform, bulbTransform, eyesTransform, PIP_AT, PIPS, placeTransform, shadeTransform, shadowTransform, wallTransform, type Pip } from '../../lib/film/parts';
import type { Locale } from '../../lib/i18n';
import Board from './Board.astro';
import Character from './Character.astro';
import Coins from './Coins.astro';
import Engine from './Engine.astro';
import Signs from './Signs.astro';
import Voices from './Voices.astro';

interface Props {
  locale: Locale;
  /** Prefix for this drawing's gradient and filter ids. */
  uid: string;
  view: StageView;
  /** The live stage: hidden from assistive technology, since the chapters tell the same story. */
  live?: boolean;
  /** What a still frame shows, for a screen reader. */
  label?: string;
}

const { locale, uid, view, live = false, label } = Astro.props;
const viewBox = viewBoxAttribute(frame(view.shot, { width: 1440, height: 900 }));
const { cast } = view;
const [youX, youY] = cast.you;
const otherX = cast.other.at[0];
/** Whether a part with this opacity is drawn: the live stage draws every part, for its script to show. */
const shows = (opacity: number) => live || opacity > 0;
const shadow = `${uid}-shadow`;
const sky = `${uid}-sky`;
const lamp = `${uid}-lamp`;
/** The night's stars (chapter 7 on), clear of the clouds and the moon, several within a phone's view. */
const STARS = [
  [140, 92, 1],
  [250, 262, 0.7],
  [470, 70, 0.9],
  [560, 228, 0.75],
  [690, 116, 1],
  [890, 62, 0.8],
  [930, 212, 0.7],
  [1140, 176, 0.9],
  [1420, 108, 1],
  [1490, 262, 0.75],
] as const;
const star = 'M0 -11 L3 -3 L11 0 L3 3 L0 11 L-3 3 L-11 0 L-3 -3 Z';
---

<svg
  class:list={['world', { 'world--live': live }]}
  viewBox={viewBox}
  preserveAspectRatio={live ? 'none' : 'xMidYMid meet'}
  role={live ? undefined : 'img'}
  aria-label={live ? undefined : label}
  aria-hidden={live ? 'true' : undefined}
  data-world={live ? 'live' : 'still'}
>
  <defs>
    <linearGradient id={sky} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={view.light['sky-top']} data-part="sky-top" />
      <stop offset="1" stop-color={view.light['sky-bottom']} data-part="sky-bottom" />
    </linearGradient>
    <radialGradient id={lamp} cx="50%" cy="58%" r="45%">
      <stop offset="0" stop-color={FILM.lamp} stop-opacity="0.9" />
      <stop offset="0.6" stop-color={FILM.lamp} stop-opacity="0.3" />
      <stop offset="1" stop-color={FILM.lamp} stop-opacity="0" />
    </radialGradient>
    <filter id={shadow} x="-40%" y="-40%" width="180%" height="190%">
      <feDropShadow dx="0" dy="9" stdDeviation="7" flood-color="#281e3c" flood-opacity="0.28" />
    </filter>
  </defs>

  <rect x="-4000" y="-4000" width="9600" height="9600" fill={`url(#${sky})`} />

  <g data-part="far">
    <circle cx="1250" cy="190" r="64" fill="#fff4c2" filter={`url(#${shadow})`} />
    <g fill="#ffffff" opacity="0.9" filter={`url(#${shadow})`}>
      <ellipse cx="300" cy="170" rx="92" ry="32" />
      <ellipse cx="362" cy="148" rx="60" ry="38" />
      <ellipse cx="1000" cy="104" rx="80" ry="26" />
      <ellipse cx="1052" cy="90" rx="50" ry="30" />
    </g>
    <g data-part="stars" opacity={view.stars}>
      {STARS.map(([x, y, size]) => <path d={star} transform={`translate(${x} ${y}) scale(${size})`} fill="#fff4c2" />)}
    </g>
    {/* The hills carry no shadow filter: they are the largest shapes, repainted whenever the camera moves. */}
    <path d="M-2000 640 C -600 420, 200 520, 700 470 S 1700 380, 3600 560 L 3600 3000 L -2000 3000 Z" fill={view.light['hill-far']} data-part="hill-far" />
  </g>
  <g data-part="near">
    <path d="M-2000 660 C -300 560, 500 600, 900 560 S 2000 520, 3600 640 L 3600 3000 L -2000 3000 Z" fill={view.light['hill-near']} data-part="hill-near" />
  </g>
  <rect x="-4000" y={WORLD.floor} width="9600" height="5000" fill={view.light.floor} data-part="floor" />
  <rect x="200" y="200" width="1200" height="700" fill={`url(#${lamp})`} opacity={view.lamp} data-part="lamp" />
  <!-- The night lamp of the character sheet: a paper shade over the table, from chapter 7 on. -->
  <g data-part="shade" transform={shadeTransform(view.shade)} opacity={view.shade > 0.01 ? 1 : 0}>
    <line x1="0" y1="-1600" x2="0" y2="-22" stroke={FILM.ink} stroke-width="3" />
    <circle cy="22" r="24" fill={FILM.lamp} opacity="0.3" />
    <g filter={`url(#${shadow})`}>
      <path d="M-50 14 L-26 -22 H26 L50 14 Z" fill={FILM.rim} stroke={FILM.ink} stroke-width="4" stroke-linejoin="round" />
    </g>
    <circle cy="22" r="12" fill={FILM.lamp} stroke={FILM.ink} stroke-width="3" />
  </g>

  {
    shows(view.rooms > 0.01 ? 1 : 0) && (
      <g data-part="wall" opacity={view.rooms > 0.01 ? 1 : 0} transform={wallTransform(view.rooms)}>
        <rect x={WORLD.centre - 11} y="420" width="22" height="228" rx="4" fill={FILM.rim} stroke={FILM.ink} stroke-width="4" filter={`url(#${shadow})`} />
      </g>
    )
  }
  {
    shows(view.bulbs > 0.01 ? 1 : 0) &&
    ([['you', youX], ['other', otherX]] as const).map(([who, x]) => (
      <g data-part={`bulb-${who}`} opacity={view.bulbs > 0.01 ? 1 : 0} transform={bulbTransform(x, view.bulbs)}>
        <line x1="0" y1="-1400" x2="0" y2="224" stroke={FILM.ink} stroke-width="3" />
        <circle cy="250" r="50" fill={FILM.lamp} opacity="0.3" />
        <rect x="-9" y="218" width="18" height="14" rx="3" fill={FILM.ink} />
        <circle cy="250" r="19" fill={FILM.lamp} stroke={FILM.ink} stroke-width="3" />
      </g>
    ))
  }

  <ellipse cx="0" cy="0" rx="70" ry="12" fill="#140f28" opacity="0.2" transform={shadowTransform({ at: cast.you, scale: 1, opacity: 1 })} data-part="shadow-you" />
  <ellipse cx="0" cy="0" rx="76" ry="12" fill="#140f28" opacity={0.2 * cast.other.opacity} transform={shadowTransform(cast.other)} data-part="shadow-other" />
  <ellipse cx="0" cy="0" rx="70" ry="12" fill="#140f28" opacity={0.2 * cast.partner.opacity} transform={shadowTransform(cast.partner)} data-part="shadow-partner" />

  {
    shows(view.thread.state === 'tied' ? view.thread.shown : 0) && (
      <g data-part="thread" opacity={view.thread.state === 'tied' ? view.thread.shown : 0}>
        <path d={threadBetween(cast.you, cast.other)} fill="none" stroke={FILM['thread-edge']} stroke-width="11" stroke-linecap="round" pathLength="1" stroke-dasharray="1" stroke-dashoffset={1 - view.thread.drawn} data-part="thread-edge" />
        <path d={threadBetween(cast.you, cast.other)} fill="none" stroke={FILM.thread} stroke-width="6" stroke-linecap="round" pathLength="1" stroke-dasharray="1" stroke-dashoffset={1 - view.thread.drawn} data-part="thread-line" />
      </g>
    )
  }

  {
    shows(view.thread.state === 'broken' ? view.thread.shown : 0) && (
      <g data-part="thread-broken" opacity={view.thread.state === 'broken' ? view.thread.shown : 0}>
        {brokenBetween(cast.you, cast.other).map((d, i) => (
          <>
            <path d={d} fill="none" stroke={FILM['thread-edge']} stroke-width="11" stroke-linecap="round" data-part={`broken-edge-${i}`} />
            <path d={d} fill="none" stroke={FILM.thread} stroke-width="6" stroke-linecap="round" data-part={`broken-line-${i}`} />
          </>
        ))}
      </g>
    )
  }

  <g transform={`translate(${youX} ${youY})`} data-part="you">
    <Character kind="circle" mood={view.moods.you} shadow={shadow} lean={!live} />
  </g>
  <g transform={placeTransform(cast.other)} opacity={cast.other.opacity} data-part="other">
    <Character kind="square" mood={view.moods.other} shadow={shadow} lean={!live} />
  </g>
  <g transform={placeTransform(cast.partner)} opacity={cast.partner.opacity} data-part="partner">
    <Character kind="triangle" mood={view.moods.partner} shadow={shadow} lean={!live} />
  </g>

  <Voices voices={view.voices} shadow={shadow} uid={uid} />

  {
    ([['you', youX], ['other', otherX]] as const).filter(([who]) => shows(view.bubbles[who])).map(([who, x]) => (
      <g data-part={`bubble-${who}`} opacity={view.bubbles[who]} transform={bubbleTransform(x, view.bubbles[who])}>
        <path d="M-26 -29 H26 A22 22 0 0 1 48 -7 V7 A22 22 0 0 1 26 29 H-12 L-50 48 L-28 27 A22 22 0 0 1 -48 7 V-7 A22 22 0 0 1 -26 -29 Z" fill={FILM.card} stroke={FILM.ink} stroke-width="3.5" stroke-linejoin="round" filter={`url(#${shadow})`} />
        <circle cx="-18" r="5.5" fill={FILM.ink} />
        <circle cx="0" r="5.5" fill={FILM.ink} />
        <circle cx="18" r="5.5" fill={FILM.ink} />
      </g>
    ))
  }

  {
    shows(view.table) && (
      <g filter={`url(#${shadow})`} data-part="table" opacity={view.table}>
        <rect x="560" y="560" width="480" height="70" rx="10" fill={FILM['table-front']} />
        <rect x="590" y="600" width="26" height="48" rx="4" fill={FILM['table-front']} />
        <rect x="984" y="600" width="26" height="48" rx="4" fill={FILM['table-front']} />
        <ellipse cx={WORLD.centre} cy={WORLD.tableTop} rx="270" ry="36" fill={FILM['table-top']} stroke={FILM.rim} stroke-width="5" />
      </g>
    )
  }

  {
    shows(view.die.opacity) && (
      <g transform={`translate(${WORLD.centre} ${view.die.y})`} opacity={view.die.opacity} data-part="die">
        <g data-part="die-spin" filter={`url(#${shadow})`}>
          <rect x="-34" y="-34" width="68" height="68" rx="14" fill="#fffaf0" stroke={FILM.ink} stroke-width="4.5" />
          {(Object.keys(PIP_AT) as Pip[]).filter((pip) => live || PIPS[view.die.face].includes(pip)).map((pip) => (
            <circle cx={PIP_AT[pip][0]} cy={PIP_AT[pip][1]} r="6.5" fill={FILM.ink} data-pip={pip} visibility={PIPS[view.die.face].includes(pip) ? 'visible' : 'hidden'} />
          ))}
        </g>
      </g>
    )
  }

  <Engine engine={view.engine} shadow={shadow} />
  <Board locale={locale} board={view.board} shadow={shadow} lean={!live} />
  <Signs locale={locale} signs={view.signs} shadow={shadow} />
  <Coins part="coins-you" x={youX} n={view.coins.you} shown={view.coins.shown} lean={!live} />
  <Coins part="coins-other" x={otherX} n={view.coins.other} shown={view.coins.shown} lean={!live} />

  <!-- The blackout (chapter 5): the stage goes dark but for the cast's eyes. -->
  <rect x="-4000" y="-4000" width="9600" height="9600" fill={FILM.ink} opacity={view.dark} data-part="dark" />
  {
    ([['you', { at: cast.you, scale: 1, opacity: 1 }, 'circle'], ['other', cast.other, 'square'], ['partner', cast.partner, 'triangle']] as const).map(([who, place, kind]) => (
      <g data-part={`eyes-${who}`} transform={eyesTransform(place, kind)} opacity={view.dark * place.opacity}>
        <ellipse cx="-21" cy="-10" rx="14" ry="16" fill="#fff" />
        <ellipse cx="21" cy="-10" rx="14" ry="16" fill="#fff" />
        <circle cx="-21" cy="-8" r="7" fill={FILM.ink} />
        <circle cx="21" cy="-8" r="7" fill={FILM.ink} />
      </g>
    ))
  }
</svg>

<style>
  .world {
    display: block;
    width: 100%;
    height: auto;
  }

  .world--live {
    height: 100%;
  }
</style>
