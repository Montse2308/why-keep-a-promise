---
/**
 * A magnifier (ADR 0024): a small link on a card of the film, where curiosity is born, to the
 * notebook page that goes deeper. It is a plain link in the card's flow, so it never interrupts the
 * scroll. Which page it opens comes from src/lib/notebook.ts (`MAGNIFIERS`), so a magnifier placed
 * on a beat the list does not name breaks the build. As a `button`, it is drawn like the cover's «Start»
 * (P9, E6): the end of chapter 7's finding, «The finding, in depth», a pill in ink.
 */
import type { ChapterId } from '../../lib/chapters';
import { FILM } from '../../lib/design/film';
import { useTranslations, type Locale } from '../../lib/i18n';
import { magnifierOn, notebookPage } from '../../lib/notebook';
import { href } from '../../lib/routes';
import { fill } from '../../lib/template';

interface Props {
  locale: Locale;
  chapter: ChapterId;
  beat: string;
  /** Drawn as a button, in ink, like the cover's «Start». */
  button?: boolean;
}

const { locale, chapter, beat, button = false } = Astro.props;
const found = magnifierOn(chapter, beat);
if (!found) throw new Error(`No magnifier on the beat "${beat}" of chapter "${chapter}"`);
const tr = useTranslations(locale);
const label = fill(tr('film.deeper'), { title: tr(notebookPage(found.page).titleKey) });
---

<p class:list={['magnifier', { 'magnifier--button': button }]}>
  <a href={href(locale, found.page)}>
    <svg viewBox="-16 -16 32 32" aria-hidden="true">
      <path d="M5 5 L13 13" stroke={FILM.ink} stroke-width="5" stroke-linecap="round" />
      <circle cx="-2" cy="-2" r="9" fill={FILM.rim} stroke={FILM.ink} stroke-width="3" />
      <path d="M-7 -3 A5.5 5.5 0 0 1 -3 -7" fill="none" stroke={FILM.thread} stroke-width="2.5" stroke-linecap="round" />
    </svg>
    <span>{label}</span>
  </a>
</p>

<style>
  .magnifier {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 800;
  }

  .magnifier a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    color: inherit;
    text-decoration-color: var(--film-thread-edge);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }

  .magnifier a:hover {
    text-decoration-color: currentColor;
  }

  /* As the cover's «Start»: a pill in ink with the card's rim for its text, a full-size target. */
  .magnifier--button a {
    padding: 0 1.15rem;
    border: 2.5px solid var(--film-ink);
    border-radius: 999px;
    background: var(--film-ink);
    color: var(--film-rim);
    font-size: 0.92rem;
    text-decoration: none;
  }

  /* The lens is drawn in ink, so on the pill it would vanish: the button is its words alone. */
  .magnifier--button svg {
    display: none;
  }

  .magnifier--button a:hover {
    background: #2c2952;
  }

  .magnifier--button a:focus-visible {
    outline: 3px solid var(--film-ink);
    outline-offset: 3px;
  }

  .magnifier svg {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
  }
</style>
