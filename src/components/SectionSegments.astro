---
/**
 * A home section's prose, segment by segment: its HTML, and the component each slot names
 * (src/lib/subpages.ts): `author-links` carries the author's name and profiles from src/config.ts.
 */
import { AUTHOR } from '../config';
import { useTranslations, type Locale } from '../lib/i18n';
import type { Segment } from '../lib/subpages';

interface Props {
  segments: readonly Segment[];
  locale: Locale;
}

const { segments, locale } = Astro.props;
const tr = useTranslations(locale);
const profiles = [
  { href: AUTHOR.github, label: tr('author.github') },
  ...(AUTHOR.linkedin ? [{ href: AUTHOR.linkedin, label: tr('author.linkedin') }] : []),
];
---

{
  segments.map((segment) =>
    segment.kind === 'html' ? (
      <Fragment set:html={segment.html} />
    ) : segment.name === 'author-links' ? (
      <>
        <p class="author">{tr('author.name')}</p>
        <nav class="links" aria-label={tr('section.about.links')}>
          <ul role="list">
            {profiles.map((profile) => (
              <li>
                <a href={profile.href} rel="me noopener">
                  {profile.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </>
    ) : null,
  )
}

<style>
  .links ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: var(--step-n1);
    font-weight: 600;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }

  .author {
    margin-bottom: var(--space-2);
    font-size: var(--step-2);
    line-height: var(--leading-tight);
  }
</style>
