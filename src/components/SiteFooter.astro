---
/**
 * The previous version's footer, until the notebook's panel replaces it (ADR 0024, P5). Its entry for
 * the finding is the notebook's entry, early: its title and the status sentence, and a link to
 * /finding only behind the lock (ADR 0026). On `/` that sentence is the second one, after chapter 7's
 * stamp.
 */
import LanguageSwitch from './LanguageSwitch.astro';
import { MANUSCRIPT_STATUS } from '../config';
import { actForSubpage } from '../lib/acts';
import { useTranslations, type Locale } from '../lib/i18n';
import { findingUnlocked, statusKey } from '../lib/lock';
import { href, SUBPAGES, type Route } from '../lib/routes';

interface Props {
  locale: Locale;
  route: Route;
}

const { locale, route } = Astro.props;
const tr = useTranslations(locale);
const unlocked = findingUnlocked(MANUSCRIPT_STATUS, import.meta.env.DEV);
const status = tr(statusKey(MANUSCRIPT_STATUS));
const links: { route: Route; label: string }[] = [
  { route: 'home', label: tr('footer.home') },
  ...SUBPAGES.map((subpage) => ({ route: subpage, label: tr(actForSubpage(subpage).titleKey) })),
];
---

<footer class="footer">
  <div class="footer__inner container">
    <nav aria-label={tr('footer.label')}>
      <ul class="footer__links">
        {
          links.map((link) => {
            const anchor = (
              <a href={href(locale, link.route)} aria-current={link.route === route ? 'page' : undefined}>
                {link.label}
              </a>
            );
            if (link.route !== 'finding') return <li>{anchor}</li>;
            return (
              <li class="footer__entry">
                {unlocked ? anchor : <span class="footer__title">{link.label}</span>}
                <span class="footer__status">{status}</span>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <LanguageSwitch locale={locale} route={route} landmark={false} />
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-16);
    padding-block: var(--space-8);
    border-top: var(--border-width) solid var(--color-border);
    font-family: var(--font-ui);
    font-size: var(--step-n1);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
  }

  .footer__links a,
  .footer__title {
    display: inline-flex;
    align-items: center;
    min-width: var(--target-min);
    min-height: var(--target-min);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__entry {
    display: flex;
    flex-direction: column;
  }

  .footer__title {
    color: var(--color-fg);
  }

  .footer__status {
    margin-top: calc(-1 * var(--space-2));
    font-style: italic;
    color: var(--color-muted);
  }

  [aria-current='page'] {
    color: var(--color-fg);
    text-decoration: none;
  }
</style>
